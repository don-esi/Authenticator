<Window x:Class="Authenticator.ProviderConnectWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
	xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
	Title="Password manager"
	Width="500"
	Height="480"
	WindowStartupLocation="CenterOwner"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}">
	<StackPanel Margin="16">
		<TextBlock x:Name="ModeHint" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

		<TextBlock Text="Provider" />
		<ComboBox x:Name="ProviderBox" Margin="0,0,0,8" SelectionChanged="ProviderBox_SelectionChanged" />
		<TextBlock x:Name="CapsText" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

		<TextBlock x:Name="UserLabel" Text="Username / email" />
		<TextBox x:Name="UserBox" Margin="0,0,0,8" />

		<TextBlock Text="Password / master password" />
		<PasswordBox x:Name="PassBox" Margin="0,0,0,8" />

		<TextBlock x:Name="PathLabel" Text="Vault / export file" />
		<Grid Margin="0,0,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBox x:Name="PathBox" VerticalAlignment="Center" />
			<syncfusion:ButtonAdv
				Grid.Column="1"
				Margin="8,0,0,0"
				Label="Browse…"
				SizeMode="Normal"
				Click="BrowsePath_Click" />
		</Grid>

		<StackPanel x:Name="KeyFilePanel">
			<TextBlock Text="Key file (optional)" />
			<Grid Margin="0,0,0,8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBox x:Name="KeyBox" VerticalAlignment="Center" />
				<syncfusion:ButtonAdv
					Grid.Column="1"
					Margin="8,0,0,0"
					Label="Browse…"
					SizeMode="Normal"
					Click="BrowseKey_Click" />
			</Grid>
		</StackPanel>

		<CheckBox
			x:Name="ImportAfterConnectCheck"
			Margin="0,4,0,12"
			Content="Import / sync entries after connecting"
			IsChecked="True"
			Visibility="Collapsed" />

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
			<syncfusion:ButtonAdv Label="Cancel" IsCancel="True" Margin="0,0,8,0" SizeMode="Normal" Click="Cancel_Click" />
			<syncfusion:ButtonAdv x:Name="PrimaryButton" Label="Connect" Click="Primary_Click" SizeMode="Normal" />
		</StackPanel>
	</StackPanel>
</Window>

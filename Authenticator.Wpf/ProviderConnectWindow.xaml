<Window x:Class="Authenticator.ProviderConnectWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
	Title="Password manager"
	Width="500"
	Height="520"
	MinWidth="420"
	MinHeight="420"
	WindowStartupLocation="CenterOwner"
	ShowInTaskbar="False"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	FontFamily="Segoe UI"
	FontSize="14">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Border Style="{StaticResource DialogHeader}">
			<Grid>
				<Button Content="Cancel"
					HorizontalAlignment="Left"
					IsCancel="True"
					Style="{StaticResource TextActionButton}"
					AutomationProperties.Name="Cancel"
					Click="Cancel_Click" />
				<TextBlock x:Name="TitleText"
					Text="Password manager"
					FontSize="17"
					FontWeight="SemiBold"
					HorizontalAlignment="Center"
					VerticalAlignment="Center" />
				<Button x:Name="PrimaryButton"
					Content="Connect"
					HorizontalAlignment="Right"
					IsDefault="True"
					Style="{StaticResource TextActionButton}"
					AutomationProperties.Name="Connect"
					Click="Primary_Click" />
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,16,16">
			<StackPanel>
				<TextBlock x:Name="ModeHint"
					FontSize="13"
					Foreground="{DynamicResource SecondaryTextBrush}"
					TextWrapping="Wrap"
					Margin="0,0,0,12" />

				<Border Style="{StaticResource DialogCard}">
					<StackPanel>
						<TextBlock Text="Provider" Style="{StaticResource DialogLabel}" />
						<ComboBox x:Name="ProviderBox"
							Style="{StaticResource DialogCombo}"
							Margin="0,0,0,8"
							SelectionChanged="ProviderBox_SelectionChanged"
							AutomationProperties.Name="Provider" />
						<TextBlock x:Name="CapsText"
							FontSize="11"
							Foreground="{DynamicResource SecondaryTextBrush}"
							TextWrapping="Wrap"
							Margin="0,0,0,12" />

						<TextBlock x:Name="UserLabel" Text="Username / email" Style="{StaticResource DialogLabel}" />
						<TextBox x:Name="UserBox"
							Style="{StaticResource DialogInput}"
							Margin="0,0,0,12"
							AutomationProperties.Name="Username" />

						<TextBlock Text="Password / master password" Style="{StaticResource DialogLabel}" />
						<Grid Margin="0,0,0,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<PasswordBox x:Name="PassBox"
								Style="{StaticResource DialogPassword}"
								AutomationProperties.Name="Password" />
							<TextBox x:Name="PassPlain"
								Style="{StaticResource DialogInput}"
								Visibility="Collapsed"
								AutomationProperties.Name="Password (visible)" />
							<Button x:Name="RevealPassButton"
								Grid.Column="1"
								Margin="8,0,0,0"
								MinWidth="40"
								Padding="8,6"
								Style="{StaticResource SecondaryButton}"
								Click="RevealPass_Click"
								ToolTip="Show password"
								AutomationProperties.Name="Show password">
								<TextBlock x:Name="RevealPassIcon"
									FontFamily="Segoe MDL2 Assets"
									FontSize="16"
									Text="&#xE7B3;" />
							</Button>
						</Grid>

						<TextBlock x:Name="PathLabel" Text="Vault / export file" Style="{StaticResource DialogLabel}" />
						<Grid Margin="0,0,0,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBox x:Name="PathBox"
								Style="{StaticResource DialogInput}"
								VerticalAlignment="Center"
								AutomationProperties.Name="Vault or export file" />
							<Button Grid.Column="1"
								Content="Browse…"
								Margin="8,0,0,0"
								Style="{StaticResource SecondaryButton}"
								Click="BrowsePath_Click"
								AutomationProperties.Name="Browse vault file" />
						</Grid>

						<StackPanel x:Name="KeyFilePanel">
							<TextBlock Text="Key file (optional)" Style="{StaticResource DialogLabel}" />
							<Grid Margin="0,0,0,4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBox x:Name="KeyBox"
									Style="{StaticResource DialogInput}"
									VerticalAlignment="Center"
									AutomationProperties.Name="Key file" />
								<Button Grid.Column="1"
									Content="Browse…"
									Margin="8,0,0,0"
									Style="{StaticResource SecondaryButton}"
									Click="BrowseKey_Click"
									AutomationProperties.Name="Browse key file" />
							</Grid>
						</StackPanel>

					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>

		<!-- Shown while logging in / importing so the window does not look frozen. MFA opens on top. -->
		<Border
			x:Name="BusyOverlay"
			Grid.RowSpan="2"
			Background="#99FFFFFF"
			Panel.ZIndex="50"
			Visibility="Collapsed"
			IsHitTestVisible="True">
			<syncfusion:SfBusyIndicator
				x:Name="BusyIndicator"
				Width="140"
				Height="140"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				AnimationType="Cupertino"
				Header="Working…"
				IsBusy="False"
				ViewboxHeight="56"
				ViewboxWidth="56" />
		</Border>
	</Grid>
</Window>

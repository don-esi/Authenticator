<UserControl x:Class="Authenticator.VaultView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:Authenticator"
	xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
	Background="Transparent">
	<UserControl.Resources>
		<Style x:Key="VaultSlideHost" TargetType="Grid">
			<Setter Property="Margin" Value="0,0,0,6" />
			<Setter Property="ClipToBounds" Value="True" />
		</Style>

		<Style x:Key="VaultFilterChip" TargetType="ToggleButton">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="12,6" />
			<Setter Property="Margin" Value="0,0,4,0" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Chrome" Property="Background" Value="#E8EAED" />
								<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
								<Setter Property="FontWeight" Value="SemiBold" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Chrome" Property="Background" Value="#F1F3F4" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Distinct from All/Favorites chips — reconciliation mode, not browse/copy. -->
		<Style x:Key="VaultConflictsFilterChip" TargetType="ToggleButton" BasedOn="{StaticResource VaultFilterChip}">
			<Setter Property="Foreground" Value="#B45309" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border x:Name="Chrome"
								Background="{TemplateBinding Background}"
								BorderBrush="#F59E0B"
								BorderThickness="1"
								CornerRadius="8"
								Padding="{TemplateBinding Padding}">
							<StackPanel Orientation="Horizontal">
								<TextBlock FontFamily="Segoe MDL2 Assets"
										   FontSize="12"
										   VerticalAlignment="Center"
										   Margin="0,0,6,0"
										   Text="&#xE7BA;" />
								<ContentPresenter VerticalAlignment="Center" />
							</StackPanel>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Chrome" Property="Background" Value="#FEF3C7" />
								<Setter TargetName="Chrome" Property="BorderBrush" Value="#D97706" />
								<Setter Property="Foreground" Value="#92400E" />
								<Setter Property="FontWeight" Value="SemiBold" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Chrome" Property="Background" Value="#FFFBEB" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="VaultRowIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
			<Setter Property="Padding" Value="4,0" />
			<Setter Property="MinWidth" Value="28" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!-- Same slide pattern as 2FA codes: actions behind card, revealed on swipe. -->
		<DataTemplate x:Key="VaultItemTemplate">
			<Grid Style="{StaticResource VaultSlideHost}" Height="64">
				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Right"
							VerticalAlignment="Stretch"
							Opacity="0"
							IsHitTestVisible="False"
							Tag="SlideActions">
					<Button Width="44" Margin="0,0,4,0" VerticalAlignment="Stretch" Tag="{Binding}"
							Click="SlideEdit_Click" Style="{StaticResource SlideActionButton}"
							Background="#9CA3AF" ToolTip="Edit" AutomationProperties.Name="Edit item">
						<TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" Text="&#xE70F;" />
					</Button>
					<Button Width="44" VerticalAlignment="Stretch" Tag="{Binding}"
							Click="SlideDelete_Click" Style="{StaticResource SlideActionButton}"
							Background="#EF4444" ToolTip="Delete" AutomationProperties.Name="Delete item">
						<TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" Text="&#xE74D;" />
					</Button>
				</StackPanel>

				<Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand" Padding="10,8"
						Loaded="VaultSlide_Loaded"
						MouseLeftButtonDown="Slide_MouseLeftButtonDown"
						MouseMove="Slide_MouseMove"
						MouseLeftButtonUp="Slide_MouseLeftButtonUp"
						LostMouseCapture="Slide_LostMouseCapture">
					<Border.RenderTransform>
						<TranslateTransform X="0" />
					</Border.RenderTransform>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<Grid Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
							<Border CornerRadius="10" Background="{Binding IconBrush}">
								<TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16" FontWeight="SemiBold"
										   HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>
							<Border Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
									Margin="-2,-2,0,0" CornerRadius="4" Background="{Binding BadgeBrush}"
									Cursor="{Binding BadgeCursor}" ToolTip="{Binding BadgeToolTip}"
									Tag="{Binding}"
									MouseLeftButtonDown="Badge_MouseLeftButtonDown">
								<TextBlock FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="White"
										   Text="{Binding BadgeGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>
						</Grid>

						<!-- Title prominent; username muted. Click row copies username. -->
						<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
							<TextBlock Text="{Binding SortTitle}" FontSize="16" FontWeight="SemiBold"
									   Foreground="{DynamicResource PrimaryTextBrush}"
									   TextTrimming="CharacterEllipsis" />
							<TextBlock Text="{Binding Identity}" FontSize="12"
									   Foreground="{DynamicResource SecondaryTextBrush}"
									   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
						</StackPanel>

						<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
							<Button Style="{StaticResource VaultRowIconButton}"
									Tag="{Binding}"
									ToolTip="Copy password"
									AutomationProperties.Name="Copy password"
									Click="CopyPassword_Click">
								<TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
										   Foreground="{DynamicResource SecondaryTextBrush}"
										   Text="&#xE8C8;" />
							</Button>
							<Button Style="{StaticResource VaultRowIconButton}"
									Tag="{Binding}"
									ToolTip="Favorite"
									AutomationProperties.Name="Favorite"
									Click="Favorite_Click">
								<TextBlock Text="{Binding Star}" Foreground="{Binding StarBrush}" FontSize="16" />
							</Button>
						</StackPanel>
					</Grid>
				</Border>
			</Grid>
		</DataTemplate>

		<!-- Conflicts filter: reconcile only — no click-copy / favorite / swipe. -->
		<DataTemplate x:Key="VaultConflictItemTemplate">
			<Border Margin="0,0,0,6"
					Padding="10,8"
					CornerRadius="12"
					Cursor="Hand"
					Background="#FFFBEB"
					BorderBrush="#F59E0B"
					BorderThickness="1.5"
					Tag="{Binding}"
					MouseLeftButtonUp="ConflictRow_Click"
					ToolTip="Open Diff to resolve password conflict">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Grid Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
						<Border CornerRadius="10" Background="{Binding IconBrush}">
							<TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16" FontWeight="SemiBold"
									   HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<Border Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
								Margin="-2,-2,0,0" CornerRadius="4" Background="#D97706">
							<TextBlock FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="White"
									   Text="&#xE7BA;" HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
					</Grid>

					<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
						<TextBlock Text="{Binding SortTitle}" FontSize="16" FontWeight="SemiBold"
								   Foreground="#92400E"
								   TextTrimming="CharacterEllipsis" />
						<TextBlock Text="{Binding Identity}" FontSize="12"
								   Foreground="#B45309"
								   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
					</StackPanel>

					<Button Grid.Column="2"
							Padding="10,6"
							VerticalAlignment="Center"
							Tag="{Binding}"
							Click="ConflictSync_Click"
							Style="{StaticResource SecondaryButton}"
							ToolTip="Open Diff"
							AutomationProperties.Name="Sync conflict">
						<StackPanel Orientation="Horizontal">
							<TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0"
									   VerticalAlignment="Center" Text="&#xE895;" />
							<TextBlock Text="Sync" VerticalAlignment="Center" FontWeight="SemiBold" />
						</StackPanel>
					</Button>
				</Grid>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="VaultGroupHeaderTemplate">
			<Button Margin="0,8,0,4"
					Padding="4,6"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Left"
					Cursor="Hand"
					Tag="{Binding}"
					Click="GroupHeader_Click"
					ToolTip="Expand or collapse group"
					AutomationProperties.Name="{Binding Title}">
				<Button.Style>
					<Style TargetType="Button" BasedOn="{StaticResource TextActionButton}">
						<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="Button">
									<Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
										<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
														  VerticalAlignment="Center" />
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</Button.Style>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
					<TextBlock FontFamily="Segoe MDL2 Assets"
							   FontSize="12"
							   VerticalAlignment="Center"
							   Margin="0,0,8,0"
							   Foreground="{DynamicResource SecondaryTextBrush}"
							   Text="{Binding Chevron}" />
					<TextBlock Text="{Binding Title}"
							   FontSize="13"
							   FontWeight="SemiBold"
							   VerticalAlignment="Center"
							   Foreground="{DynamicResource SecondaryTextBrush}" />
					<TextBlock Text="{Binding CountLabel}"
							   Margin="8,0,0,0"
							   FontSize="12"
							   VerticalAlignment="Center"
							   Foreground="{DynamicResource SecondaryTextBrush}" />
				</StackPanel>
			</Button>
		</DataTemplate>

		<!-- After item/header templates so StaticResource keys resolve. -->
		<local:VaultListTemplateSelector x:Key="VaultListTemplateSelector"
										 ItemTemplate="{StaticResource VaultItemTemplate}"
										 ConflictItemTemplate="{StaticResource VaultConflictItemTemplate}"
										 HeaderTemplate="{StaticResource VaultGroupHeaderTemplate}" />
	</UserControl.Resources>

	<Grid Margin="12,8,12,4">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TextBlock
			HorizontalAlignment="Center"
			FontSize="22"
			FontWeight="SemiBold"
			Foreground="{DynamicResource PrimaryTextBrush}"
			Text="Vault" />

		<ScrollViewer Grid.Row="1" Margin="0,10,0,4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
			<StackPanel Orientation="Horizontal">
				<ToggleButton x:Name="ChipRelevant" Content="All relevant" Style="{StaticResource VaultFilterChip}" Checked="FilterChip_Checked" Unchecked="FilterChip_Unchecked" />
				<ToggleButton x:Name="ChipAll" Content="All items" Style="{StaticResource VaultFilterChip}" IsChecked="True" Checked="FilterChip_Checked" Unchecked="FilterChip_Unchecked" />
				<ToggleButton x:Name="ChipFavorites" Content="Favorites" Style="{StaticResource VaultFilterChip}" Checked="FilterChip_Checked" Unchecked="FilterChip_Unchecked" />
				<ToggleButton x:Name="ChipRecents" Content="Recents" Style="{StaticResource VaultFilterChip}" Checked="FilterChip_Checked" Unchecked="FilterChip_Unchecked" />
				<ToggleButton x:Name="ChipConflicts" Content="Conflicts" Style="{StaticResource VaultConflictsFilterChip}" Visibility="Collapsed" Checked="FilterChip_Checked" Unchecked="FilterChip_Unchecked" />
			</StackPanel>
		</ScrollViewer>

		<Grid Grid.Row="2" Margin="0,4,0,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Grid>
				<syncfusion:SfTextBoxExt
					x:Name="SearchBox"
					Watermark="Search title, username, URL, password"
					Padding="8,6,28,6"
					TextChanged="SearchBox_TextChanged" />
				<Button x:Name="SearchClearButton"
						HorizontalAlignment="Right"
						VerticalAlignment="Center"
						Margin="0,0,4,0"
						Padding="4"
						MinWidth="24"
						Visibility="Collapsed"
						Style="{StaticResource IconButton}"
						ToolTip="Clear search"
						AutomationProperties.Name="Clear search"
						Click="SearchClear_Click">
					<TextBlock FontFamily="Segoe MDL2 Assets"
							   FontSize="12"
							   Foreground="{DynamicResource SecondaryTextBrush}"
							   Text="&#xE711;" />
				</Button>
			</Grid>
			<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
				<TextBlock
					x:Name="FilterHint"
					VerticalAlignment="Center"
					Margin="0,0,8,0"
					FontSize="11"
					Foreground="{DynamicResource SecondaryTextBrush}" />
				<Button x:Name="GroupButton"
						Style="{StaticResource IconButton}"
						ToolTip="Group"
						AutomationProperties.Name="Group vault items"
						Click="GroupButton_Click">
					<TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
							   Foreground="{DynamicResource BrandBlueBrush}" Text="&#xE8F5;" />
					<Button.ContextMenu>
						<ContextMenu Opened="GroupMenu_Opened">
							<MenuItem Header="None" Tag="None" Click="GroupMenuItem_Click" />
							<Separator />
							<MenuItem Header="Entry type" Tag="EntryType" Click="GroupMenuItem_Click" />
							<MenuItem Header="URL domain" Tag="UrlDomain" Click="GroupMenuItem_Click" />
							<MenuItem Header="Username" Tag="Username" Click="GroupMenuItem_Click" />
						</ContextMenu>
					</Button.ContextMenu>
				</Button>
				<Button x:Name="SortButton"
						Margin="2,0,0,0"
						Style="{StaticResource IconButton}"
						ToolTip="Sort"
						AutomationProperties.Name="Sort vault items"
						Click="SortButton_Click">
					<TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
							   Foreground="{DynamicResource BrandBlueBrush}" Text="&#xE8CB;" />
					<Button.ContextMenu>
						<ContextMenu Opened="SortMenu_Opened">
							<MenuItem Header="Title A &gt; Z" Tag="TitleAsc" Click="SortMenuItem_Click" />
							<MenuItem Header="Title Z &gt; A" Tag="TitleDesc" Click="SortMenuItem_Click" />
							<Separator />
							<MenuItem Header="Username A &gt; Z" Tag="UsernameAsc" Click="SortMenuItem_Click" />
							<MenuItem Header="Username Z &gt; A" Tag="UsernameDesc" Click="SortMenuItem_Click" />
						</ContextMenu>
					</Button.ContextMenu>
				</Button>
			</StackPanel>
		</Grid>

		<!-- Virtualizing panel (ScrollViewer inside template) — avoids realizing every card on All items. -->
		<Grid Grid.Row="3">
			<ItemsControl
				x:Name="ItemsList"
				ItemTemplateSelector="{StaticResource VaultListTemplateSelector}"
				VirtualizingPanel.IsVirtualizing="True"
				VirtualizingPanel.VirtualizationMode="Recycling"
				VirtualizingPanel.ScrollUnit="Pixel"
				ScrollViewer.CanContentScroll="True">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<VirtualizingStackPanel />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.Template>
					<ControlTemplate TargetType="ItemsControl">
						<ScrollViewer
							CanContentScroll="True"
							Focusable="False"
							HorizontalScrollBarVisibility="Disabled"
							VerticalScrollBarVisibility="Auto">
							<ItemsPresenter />
						</ScrollViewer>
					</ControlTemplate>
				</ItemsControl.Template>
			</ItemsControl>
			<Border x:Name="StatusToast"
					HorizontalAlignment="Center"
					VerticalAlignment="Bottom"
					Margin="0,0,0,16"
					Padding="18,10"
					Background="{DynamicResource ToastBackgroundBrush}"
					CornerRadius="20"
					Opacity="0.92"
					IsHitTestVisible="False"
					Visibility="Collapsed">
				<TextBlock x:Name="ToastText"
						   Text="Copied"
						   Foreground="White"
						   FontSize="14"
						   FontWeight="SemiBold" />
			</Border>

			<Border
				x:Name="BusyOverlay"
				Background="#99FFFFFF"
				Panel.ZIndex="80"
				Visibility="Collapsed"
				IsHitTestVisible="True">
				<syncfusion:SfBusyIndicator
					x:Name="BusyIndicator"
					Width="140"
					Height="140"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					AnimationType="Cupertino"
					Header="Syncing…"
					IsBusy="False"
					ViewboxHeight="56"
					ViewboxWidth="56" />
			</Border>
		</Grid>
	</Grid>
</UserControl>

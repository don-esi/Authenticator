<UserControl x:Class="Authenticator.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20,16,20,8">
        <Grid x:Name="ListPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Backup Codes"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       HorizontalAlignment="Left"
                       Margin="0,8,0,16" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="EmptyText"
                               Text="No accounts have backup codes."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Left"
                               Margin="0,40,0,0"
                               Visibility="Collapsed" />
                    <ItemsControl x:Name="AccountList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Stretch"
                                        Margin="0,0,0,10"
                                        Padding="0"
                                        Click="Account_Click"
                                        Tag="{Binding}"
                                        Style="{StaticResource SecondaryButton}"
                                        Background="{DynamicResource CardBackgroundBrush}">
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="10" Background="{Binding InitialBrush}" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding ServiceName}" FontWeight="SemiBold" FontSize="16"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="{Binding Username}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding AvailableText}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="DetailPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button HorizontalAlignment="Left" Content="Back" Click="Back_Click" Style="{StaticResource TextActionButton}" />
            <StackPanel Grid.Row="1" Margin="0,8,0,12">
                <TextBlock x:Name="DetailTitle" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock x:Name="DetailUser" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CodeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Copy" Margin="8,0,0,0" Tag="{Binding}" Click="CopyCode_Click" Style="{StaticResource SecondaryButton}" />
                                    <Button Grid.Column="2" Content="Mark used" Margin="8,0,0,0" Tag="{Binding}" Click="MarkUsed_Click" IsEnabled="{Binding CanMarkUsed}" Style="{StaticResource PrimaryButton}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

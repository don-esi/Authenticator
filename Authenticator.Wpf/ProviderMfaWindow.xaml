<Window x:Class="Authenticator.ProviderMfaWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Two-factor authentication"
	Width="420"
	SizeToContent="Height"
	MinWidth="360"
	MaxWidth="480"
	WindowStartupLocation="CenterOwner"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	FontFamily="Segoe UI"
	FontSize="14"
	Closing="Window_Closing">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border Style="{StaticResource DialogHeader}">
			<TextBlock Text="Two-factor authentication"
				FontSize="17"
				FontWeight="SemiBold"
				HorizontalAlignment="Center"
				VerticalAlignment="Center" />
		</Border>

		<Border Grid.Row="1" Style="{StaticResource DialogCard}" Margin="16,12,16,0">
			<StackPanel>
				<TextBlock x:Name="MfaStatus"
					Margin="0,0,0,12"
					FontSize="13"
					Foreground="{DynamicResource SecondaryTextBrush}"
					TextWrapping="Wrap"
					Text="Enter the authenticator code" />
				<TextBox
					x:Name="MfaBox"
					MaxLength="48"
					Style="{StaticResource DialogInput}"
					Margin="0,0,0,12"
					PreviewKeyDown="MfaBox_PreviewKeyDown"
					TextChanged="MfaBox_TextChanged"
					AutomationProperties.Name="MFA code" />
				<CheckBox
					x:Name="MfaRemember"
					Margin="0,0,0,12"
					Content="Remember this computer"
					IsChecked="True"
					Style="{StaticResource DialogCheck}" />
				<TextBlock x:Name="AltMethodsLabel"
					Text="Or use another method"
					Style="{StaticResource DialogLabel}"
					Visibility="Collapsed" />
				<WrapPanel x:Name="AltMethods" Margin="0,0,0,4" />
			</StackPanel>
		</Border>

		<Border Grid.Row="2" Style="{StaticResource DialogFooter}">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button Content="Cancel"
					Margin="0,0,8,0"
					Style="{StaticResource SecondaryButton}"
					IsCancel="True"
					Click="Cancel_Click"
					AutomationProperties.Name="Cancel MFA" />
				<Button x:Name="SubmitButton"
					Content="Submit"
					Style="{StaticResource PrimaryButton}"
					IsDefault="True"
					Click="Submit_Click"
					AutomationProperties.Name="Submit MFA" />
			</StackPanel>
		</Border>
	</Grid>
</Window>

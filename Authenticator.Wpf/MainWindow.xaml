<Window x:Class="Authenticator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Authenticator"
        Height="640"
        Width="920"
        MinHeight="360"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="AddButton"
                    Content="Add account"
                    Width="120"
                    Margin="0,0,8,0"
                    Padding="8,4"
                    Click="AddButton_Click" />
            <Button x:Name="DeleteButton"
                    Content="Delete account"
                    Width="130"
                    Margin="0,0,8,0"
                    Padding="8,4"
                    Click="DeleteButton_Click" />
            <Button x:Name="CopyButton"
                    Content="Copy code"
                    Width="110"
                    Padding="8,4"
                    Click="CopyButton_Click" />
            <TextBlock x:Name="StatusText"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Grid>
            <ListView x:Name="AccountList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Service" Width="220" DisplayMemberBinding="{Binding ServiceName}" />
                        <GridViewColumn Header="Username" Width="280" DisplayMemberBinding="{Binding Username}" />
                        <GridViewColumn Header="Code" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Code}"
                                               FontFamily="Consolas"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Seconds" Width="90" DisplayMemberBinding="{Binding SecondsRemaining}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="EmptyText"
                       Text="No accounts."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#666666"
                       Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>

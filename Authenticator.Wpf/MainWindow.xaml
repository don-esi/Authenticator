<Window x:Class="Authenticator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Authenticator"
        Title="Authenticator"
        Width="780"
        Height="900"
        MinWidth="420"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA"
        FontFamily="Segoe UI"
        FontSize="14"
        Foreground="#1F2937"
        PreviewMouseDown="Window_PreviewActivity"
        PreviewMouseWheel="Window_PreviewActivity"
        PreviewKeyDown="Window_PreviewActivity"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="PageHost" Grid.Row="0">
            <local:CodesView x:Name="CodesPage" />
            <local:BackupView x:Name="BackupPage" Visibility="Collapsed" />
            <local:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CodesNavButton" Grid.Column="0" Click="CodesNav_Click" Style="{StaticResource TextActionButton}" AutomationProperties.Name="2FA Codes">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Text="&#xE192;" />
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Text="2FA Codes" />
                    </StackPanel>
                </Button>
                <Button x:Name="BackupNavButton" Grid.Column="1" Click="BackupNav_Click" Style="{StaticResource TextActionButton}" Foreground="#6B7280" AutomationProperties.Name="Backup Codes">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Text="&#xE72C;" />
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Text="Backup Codes" />
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsNavButton" Grid.Column="2" Click="SettingsNav_Click" Style="{StaticResource TextActionButton}" Foreground="#6B7280" AutomationProperties.Name="Settings">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Text="&#xE713;" />
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Text="Settings" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid x:Name="LockOverlay" Grid.RowSpan="2" Background="#F8F9FA" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="42" Foreground="#0078D4" HorizontalAlignment="Center" Text="&#xE72E;" />
                <TextBlock Margin="0,12,0,0" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Locked" />
                <TextBlock Margin="0,8,0,20" Foreground="#6B7280" HorizontalAlignment="Center" Text="Codes are hidden until you unlock." />
                <Button Content="Unlock" Padding="28,10" Click="Unlock_Click" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

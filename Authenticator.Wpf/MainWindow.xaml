<Window
	x:Class="Authenticator.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:Authenticator"
	Title="Authenticator"
	Width="420"
	Height="900"
	MinWidth="420"
	MinHeight="640"
	Background="#F8F9FA"
	Closed="Window_Closed"
	FontFamily="Segoe UI"
	FontSize="14"
	Foreground="#1F2937"
	Loaded="Window_Loaded"
	PreviewKeyDown="Window_PreviewActivity"
	PreviewMouseDown="Window_PreviewActivity"
	PreviewMouseWheel="Window_PreviewActivity"
	WindowStartupLocation="CenterScreen">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid x:Name="PageHost" Grid.Row="0">
			<local:CodesView x:Name="CodesPage" />
			<local:BackupView x:Name="BackupPage" Visibility="Collapsed" />
			<local:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
		</Grid>

		<Border
			Grid.Row="1"
			Padding="8,6"
			Background="White"
			BorderBrush="#E5E7EB"
			BorderThickness="0,1,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Button
					x:Name="CodesNavButton"
					Grid.Column="0"
					AutomationProperties.Name="2FA Codes"
					Click="CodesNav_Click"
					Style="{StaticResource TextActionButton}">
					<StackPanel>
						<TextBlock
							HorizontalAlignment="Center"
							FontFamily="Segoe MDL2 Assets"
							FontSize="18"
							Text="&#xE192;" />
						<TextBlock
							HorizontalAlignment="Center"
							FontSize="12"
							Text="2FA Codes" />
					</StackPanel>
				</Button>
				<Button
					x:Name="BackupNavButton"
					Grid.Column="1"
					AutomationProperties.Name="Backup Codes"
					Click="BackupNav_Click"
					Foreground="#6B7280"
					Style="{StaticResource TextActionButton}">
					<StackPanel>
						<TextBlock
							HorizontalAlignment="Center"
							FontFamily="Segoe MDL2 Assets"
							FontSize="18"
							Text="&#xE72C;" />
						<TextBlock
							HorizontalAlignment="Center"
							FontSize="12"
							Text="Backup Codes" />
					</StackPanel>
				</Button>
				<Button
					x:Name="SettingsNavButton"
					Grid.Column="2"
					AutomationProperties.Name="Settings"
					Click="SettingsNav_Click"
					Foreground="#6B7280"
					Style="{StaticResource TextActionButton}">
					<StackPanel>
						<TextBlock
							HorizontalAlignment="Center"
							FontFamily="Segoe MDL2 Assets"
							FontSize="18"
							Text="&#xE713;" />
						<TextBlock
							HorizontalAlignment="Center"
							FontSize="12"
							Text="Settings" />
					</StackPanel>
				</Button>
			</Grid>
		</Border>

		<Grid
			x:Name="LockOverlay"
			Grid.RowSpan="2"
			Background="#F8F9FA"
			Visibility="Collapsed">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
				<TextBlock
					HorizontalAlignment="Center"
					FontFamily="Segoe MDL2 Assets"
					FontSize="42"
					Foreground="#0078D4"
					Text="&#xE72E;" />
				<TextBlock
					Margin="0,12,0,0"
					HorizontalAlignment="Center"
					FontSize="28"
					FontWeight="SemiBold"
					Text="Locked" />
				<TextBlock
					Margin="0,8,0,20"
					HorizontalAlignment="Center"
					Foreground="#6B7280"
					Text="Codes are hidden until you unlock." />
				<Button
					Padding="28,10"
					Click="Unlock_Click"
					Content="Unlock"
					Style="{StaticResource PrimaryButton}" />
			</StackPanel>
		</Grid>
	</Grid>
</Window>
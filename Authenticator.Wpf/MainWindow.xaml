<Window
	x:Class="Authenticator.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:Authenticator"
	Title="Authenticator"
	Width="420"
	Height="900"
	MinWidth="420"
	MinHeight="640"
	Icon="pack://application:,,,/Assets/app.ico"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	Activated="Window_Activated"
	Deactivated="Window_Deactivated"
	Closing="Window_Closing"
	Closed="Window_Closed"
	FontFamily="Segoe UI"
	FontSize="14"
	Loaded="Window_Loaded"
	PreviewKeyDown="Window_PreviewActivity"
	PreviewMouseDown="Window_PreviewActivity"
	PreviewMouseWheel="Window_PreviewActivity"
	WindowStartupLocation="CenterScreen">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid x:Name="PageHost" Grid.Row="0">
			<local:CodesView x:Name="CodesPage" />
			<local:BackupView x:Name="BackupPage" Visibility="Collapsed" />
			<local:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
		</Grid>

		<Border
			Grid.Row="1"
			Padding="8,6"
			Background="{DynamicResource NavBarBackgroundBrush}"
			BorderBrush="{DynamicResource BorderBrushColor}"
			BorderThickness="0,1,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Button
					x:Name="CodesNavButton"
					Grid.Column="0"
					AutomationProperties.Name="2FA Codes"
					Click="CodesNav_Click"
					Style="{StaticResource TextActionButton}">
					<StackPanel>
						<TextBlock
							HorizontalAlignment="Center"
							FontFamily="Segoe MDL2 Assets"
							FontSize="18"
							Text="&#xE192;" />
						<TextBlock
							HorizontalAlignment="Center"
							FontSize="12"
							Text="2FA Codes" />
					</StackPanel>
				</Button>
				<Button
					x:Name="BackupNavButton"
					Grid.Column="1"
					AutomationProperties.Name="Backup Codes"
					Click="BackupNav_Click"
					Foreground="{DynamicResource SecondaryTextBrush}"
					Style="{StaticResource TextActionButton}">
					<StackPanel>
						<TextBlock
							HorizontalAlignment="Center"
							FontFamily="Segoe MDL2 Assets"
							FontSize="18"
							Text="&#xE72C;" />
						<TextBlock
							HorizontalAlignment="Center"
							FontSize="12"
							Text="Backup Codes" />
					</StackPanel>
				</Button>
				<Button
					x:Name="SettingsNavButton"
					Grid.Column="2"
					AutomationProperties.Name="Settings"
					Click="SettingsNav_Click"
					Foreground="{DynamicResource SecondaryTextBrush}"
					Style="{StaticResource TextActionButton}">
					<StackPanel>
						<TextBlock
							HorizontalAlignment="Center"
							FontFamily="Segoe MDL2 Assets"
							FontSize="18"
							Text="&#xE713;" />
						<TextBlock
							HorizontalAlignment="Center"
							FontSize="12"
							Text="Settings" />
					</StackPanel>
				</Button>
				<StackPanel
					Grid.Column="3"
					Orientation="Horizontal"
					VerticalAlignment="Center">
					<ToggleButton
						x:Name="PinDockButton"
						Margin="4,0,0,0"
						Padding="10,4"
						VerticalAlignment="Center"
						AutomationProperties.Name="Pin window open"
						Checked="PinDock_Changed"
						Unchecked="PinDock_Changed"
						Style="{StaticResource SecondaryToggleButton}"
						ToolTip="Keep open (do not auto-collapse)"
						Visibility="Collapsed">
						<TextBlock
							x:Name="PinDockIcon"
							FontFamily="Segoe MDL2 Assets"
							FontSize="16"
							Text="&#xE718;" />
					</ToggleButton>
					<Button
						x:Name="CollapseDockButton"
						Margin="4,0,0,0"
						Padding="10,4"
						VerticalAlignment="Center"
						AutomationProperties.Name="Collapse to dock"
						Click="CollapseDock_Click"
						Style="{StaticResource SecondaryButton}"
						ToolTip="Collapse to edge handle"
						Visibility="Collapsed">
						<TextBlock
							FontFamily="Segoe MDL2 Assets"
							FontSize="16"
							Text="&#xE76C;" />
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<Grid
			x:Name="LockOverlay"
			Grid.RowSpan="2"
			Background="{DynamicResource PageBackgroundBrush}"
			FocusManager.IsFocusScope="True"
			PreviewTextInput="LockOverlay_PreviewTextInput"
			PreviewKeyDown="LockOverlay_PreviewKeyDown"
			Visibility="Collapsed">
			<StackPanel
				Width="280"
				HorizontalAlignment="Center"
				VerticalAlignment="Center">
				<TextBlock
					HorizontalAlignment="Center"
					FontFamily="Segoe MDL2 Assets"
					FontSize="42"
					Foreground="{DynamicResource BrandBlueBrush}"
					Text="&#xE72E;" />
				<TextBlock
					Margin="0,12,0,0"
					HorizontalAlignment="Center"
					FontSize="28"
					FontWeight="SemiBold"
					Foreground="{DynamicResource PrimaryTextBrush}"
					Text="Locked" />
				<TextBlock
					x:Name="UnlockHintText"
					Margin="0,8,0,20"
					HorizontalAlignment="Center"
					Foreground="{DynamicResource SecondaryTextBrush}"
					TextWrapping="Wrap"
					TextAlignment="Center"
					Text="Enter your PIN or touch your YubiKey." />

				<StackPanel x:Name="PinUnlockPanel">
					<PasswordBox
						x:Name="UnlockPinBox"
						Height="40"
						Padding="10,8"
						Margin="0,0,0,10"
						Focusable="True"
						Background="{DynamicResource SecondaryBackgroundBrush}"
						Foreground="{DynamicResource PrimaryTextBrush}"
						CaretBrush="{DynamicResource PrimaryTextBrush}"
						BorderBrush="{DynamicResource BorderBrushColor}"
						AutomationProperties.Name="PIN"
						LostKeyboardFocus="UnlockPinBox_LostKeyboardFocus"
						KeyDown="UnlockPinBox_KeyDown" />
					<Button
						Padding="28,10"
						Click="UnlockPin_Click"
						Content="Unlock with PIN"
						Style="{StaticResource PrimaryButton}" />
				</StackPanel>

				<StackPanel x:Name="YubiUnlockPanel" Margin="0,4,0,0">
					<TextBlock
						HorizontalAlignment="Center"
						Foreground="{DynamicResource BrandBlueBrush}"
						Text="Waiting for YubiKey…" />
					<!-- Receives Yubico OTP keystrokes from a touch; kept effectively invisible. -->
					<TextBox
						x:Name="YubiOtpCaptureBox"
						Height="1"
						Margin="0,8,0,0"
						Opacity="0.01"
						BorderThickness="0"
						CaretBrush="Transparent"
						Foreground="Transparent"
						Background="Transparent"
						Focusable="True"
						IsTabStop="False"
						TextChanged="YubiOtpCaptureBox_TextChanged"
						PreviewKeyDown="YubiOtpCaptureBox_PreviewKeyDown"
						AutomationProperties.Name="YubiKey OTP capture" />
				</StackPanel>

				<StackPanel x:Name="HelloUnlockPanel" Margin="0,12,0,0" Visibility="Collapsed">
					<Button
						Padding="28,10"
						Click="UnlockHello_Click"
						Content="Unlock with Windows Hello"
						Style="{StaticResource PrimaryButton}" />
				</StackPanel>

				<TextBlock
					x:Name="UnlockErrorText"
					Margin="0,14,0,0"
					HorizontalAlignment="Center"
					Foreground="{DynamicResource DangerBrush}"
					TextWrapping="Wrap"
					TextAlignment="Center" />
			</StackPanel>
		</Grid>
	</Grid>
</Window>

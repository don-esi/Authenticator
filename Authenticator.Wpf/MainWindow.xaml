<Window
	x:Class="Authenticator.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:Authenticator"
	xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
	xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
	Title="Authenticator"
	syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
	Width="420"
	Height="900"
	MinWidth="420"
	MinHeight="640"
	Icon="pack://application:,,,/Assets/app.ico"
	Background="White"
	Foreground="{DynamicResource PrimaryTextBrush}"
	Activated="Window_Activated"
	Deactivated="Window_Deactivated"
	Closing="Window_Closing"
	Closed="Window_Closed"
	FontFamily="Segoe UI"
	FontSize="14"
	Loaded="Window_Loaded"
	PreviewKeyDown="Window_PreviewActivity"
	PreviewMouseDown="Window_PreviewActivity"
	PreviewMouseWheel="Window_PreviewActivity"
	WindowStartupLocation="Manual">
	<Grid Background="{DynamicResource PageBackgroundBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Top tabs -->
		<Border
			Grid.Row="0"
			Padding="8,6"
			Background="{DynamicResource NavBarBackgroundBrush}"
			BorderBrush="{DynamicResource BorderBrushColor}"
			BorderThickness="0,0,0,1">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Button
					x:Name="TopCodesTab"
					Click="TopCodesTab_Click"
					Style="{StaticResource TextActionButton}"
					Content="2FA Codes" />
				<Button
					x:Name="TopVaultTab"
					Grid.Column="1"
					Click="TopVaultTab_Click"
					Foreground="{DynamicResource SecondaryTextBrush}"
					Style="{StaticResource TextActionButton}"
					Content="Vault" />
				<TextBlock
					x:Name="OfflineBadge"
					Grid.Column="2"
					Margin="8,0,4,0"
					VerticalAlignment="Center"
					FontSize="11"
					FontWeight="SemiBold"
					Foreground="{DynamicResource DangerBrush}"
					Text="OFFLINE"
					Visibility="Collapsed" />
			</Grid>
		</Border>

		<!-- Non-blocking status while providers reconnect after unlock. -->
		<Border
			x:Name="ReconnectBanner"
			Grid.Row="1"
			Padding="12,8"
			Background="{DynamicResource SecondaryBackgroundBrush}"
			BorderBrush="{DynamicResource BorderBrushColor}"
			BorderThickness="0,0,0,1"
			Visibility="Collapsed">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<syncfusion:SfBusyIndicator
					Width="28"
					Height="28"
					VerticalAlignment="Center"
					AnimationType="Cupertino"
					IsBusy="True"
					ViewboxHeight="18"
					ViewboxWidth="18" />
				<TextBlock
					x:Name="ReconnectBannerText"
					Grid.Column="1"
					Margin="10,0,0,0"
					VerticalAlignment="Center"
					Foreground="{DynamicResource SecondaryTextBrush}"
					Text="Reconnecting password managers…"
					TextWrapping="Wrap" />
			</Grid>
		</Border>

		<Grid x:Name="PageHost" Grid.Row="2">
			<local:CodesView x:Name="CodesPage" />
			<local:BackupView x:Name="BackupPage" Visibility="Collapsed" />
			<local:VaultView x:Name="VaultPage" Visibility="Collapsed" />
			<local:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
		</Grid>

		<!-- Contextual bottom bar -->
		<Border
			Grid.Row="3"
			Padding="8,6"
			Background="{DynamicResource NavBarBackgroundBrush}"
			BorderBrush="{DynamicResource BorderBrushColor}"
			BorderThickness="0,1,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel x:Name="CodesContextBar" Orientation="Horizontal">
					<Button x:Name="CodesNavButton" Click="CodesNav_Click" Style="{StaticResource TextActionButton}" Margin="0,0,4,0">
						<StackPanel>
							<TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE192;" />
							<TextBlock HorizontalAlignment="Center" FontSize="11" Text="Codes" />
						</StackPanel>
					</Button>
					<Button x:Name="BackupNavButton" Click="BackupNav_Click" Foreground="{DynamicResource SecondaryTextBrush}" Style="{StaticResource TextActionButton}" Margin="0,0,4,0">
						<StackPanel>
							<TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE72C;" />
							<TextBlock HorizontalAlignment="Center" FontSize="11" Text="Backup" />
						</StackPanel>
					</Button>
					<Button x:Name="CodesFavoritesButton" Click="CodesFavorites_Click" Foreground="{DynamicResource SecondaryTextBrush}" Style="{StaticResource TextActionButton}" Margin="0,0,4,0">
						<StackPanel>
							<TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE734;" />
							<TextBlock HorizontalAlignment="Center" FontSize="11" Text="Favorites" />
						</StackPanel>
					</Button>
				</StackPanel>
				<StackPanel x:Name="VaultContextBar" Orientation="Horizontal" Visibility="Collapsed">
					<Button Click="VaultAll_Click" Style="{StaticResource TextActionButton}" Margin="0,0,4,0">
						<StackPanel>
							<TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE8F1;" />
							<TextBlock HorizontalAlignment="Center" FontSize="11" Text="All" />
						</StackPanel>
					</Button>
					<Button Click="VaultFavorites_Click" Style="{StaticResource TextActionButton}" Margin="0,0,4,0">
						<StackPanel>
							<TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE734;" />
							<TextBlock HorizontalAlignment="Center" FontSize="11" Text="Favorites" />
						</StackPanel>
					</Button>
					<Button Click="VaultAdd_Click" Style="{StaticResource TextActionButton}" Margin="0,0,4,0">
						<StackPanel>
							<TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE710;" />
							<TextBlock HorizontalAlignment="Center" FontSize="11" Text="Add" />
						</StackPanel>
					</Button>
					<Button x:Name="VaultProvidersButton" Click="VaultProviders_Click" Style="{StaticResource TextActionButton}" Margin="0,0,4,0"
						ToolTip="Connect to or import from password managers">
						<StackPanel>
							<TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE8B5;" />
							<TextBlock HorizontalAlignment="Center" FontSize="11" Text="Providers" />
						</StackPanel>
					</Button>
				</StackPanel>
				<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
					<Button x:Name="SettingsNavButton" Click="SettingsNav_Click" Foreground="{DynamicResource SecondaryTextBrush}" Style="{StaticResource TextActionButton}" Margin="0,0,4,0">
						<StackPanel>
							<TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE713;" />
							<TextBlock HorizontalAlignment="Center" FontSize="11" Text="Settings" />
						</StackPanel>
					</Button>
					<Button Click="LockNow_Click" Style="{StaticResource TextActionButton}" Margin="0,0,4,0" ToolTip="Lock">
						<TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE72E;" />
					</Button>
					<ToggleButton
						x:Name="PinDockButton"
						Margin="4,0,0,0"
						Padding="10,4"
						VerticalAlignment="Center"
						AutomationProperties.Name="Pin window open"
						Checked="PinDock_Changed"
						Unchecked="PinDock_Changed"
						Style="{StaticResource SecondaryToggleButton}"
						ToolTip="Keep open (do not auto-collapse)"
						Visibility="Collapsed">
						<TextBlock x:Name="PinDockIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE718;" />
					</ToggleButton>
					<Button
						x:Name="CollapseDockButton"
						Margin="4,0,0,0"
						Padding="10,4"
						VerticalAlignment="Center"
						AutomationProperties.Name="Collapse to dock"
						Click="CollapseDock_Click"
						Style="{StaticResource SecondaryButton}"
						ToolTip="Collapse to edge handle"
						Visibility="Collapsed">
						<TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE76C;" />
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<Grid
			x:Name="LockOverlay"
			Grid.RowSpan="4"
			Background="{DynamicResource PageBackgroundBrush}"
			FocusManager.IsFocusScope="True"
			PreviewTextInput="LockOverlay_PreviewTextInput"
			PreviewKeyDown="LockOverlay_PreviewKeyDown"
			Visibility="Collapsed">
			<StackPanel
				Width="280"
				HorizontalAlignment="Center"
				VerticalAlignment="Center">
				<TextBlock
					HorizontalAlignment="Center"
					FontFamily="Segoe MDL2 Assets"
					FontSize="42"
					Foreground="{DynamicResource BrandBlueBrush}"
					Text="&#xE72E;" />
				<TextBlock
					Margin="0,12,0,0"
					HorizontalAlignment="Center"
					FontSize="28"
					FontWeight="SemiBold"
					Foreground="{DynamicResource PrimaryTextBrush}"
					Text="Locked" />
				<TextBlock
					x:Name="UnlockHintText"
					Margin="0,8,0,20"
					HorizontalAlignment="Center"
					Foreground="{DynamicResource SecondaryTextBrush}"
					TextWrapping="Wrap"
					TextAlignment="Center"
					Text="Enter your PIN or touch your YubiKey." />

				<StackPanel x:Name="PinUnlockPanel">
					<PasswordBox
						x:Name="UnlockPinBox"
						Height="40"
						Padding="10,8"
						Margin="0,0,0,10"
						Focusable="True"
						Background="{DynamicResource SecondaryBackgroundBrush}"
						Foreground="{DynamicResource PrimaryTextBrush}"
						CaretBrush="{DynamicResource PrimaryTextBrush}"
						BorderBrush="{DynamicResource BorderBrushColor}"
						AutomationProperties.Name="PIN"
						LostKeyboardFocus="UnlockPinBox_LostKeyboardFocus"
						KeyDown="UnlockPinBox_KeyDown" />
					<Button
						Padding="28,10"
						Click="UnlockPin_Click"
						Content="Unlock with PIN"
						Style="{StaticResource PrimaryButton}" />
				</StackPanel>

				<StackPanel x:Name="YubiUnlockPanel" Margin="0,4,0,0">
					<TextBlock
						HorizontalAlignment="Center"
						Foreground="{DynamicResource BrandBlueBrush}"
						Text="Waiting for YubiKey…" />
					<TextBox
						x:Name="YubiOtpCaptureBox"
						Height="1"
						Margin="0,8,0,0"
						Opacity="0.01"
						BorderThickness="0"
						CaretBrush="Transparent"
						Foreground="Transparent"
						Background="Transparent"
						Focusable="True"
						IsTabStop="False"
						TextChanged="YubiOtpCaptureBox_TextChanged"
						PreviewKeyDown="YubiOtpCaptureBox_PreviewKeyDown"
						AutomationProperties.Name="YubiKey OTP capture" />
				</StackPanel>

				<StackPanel x:Name="HelloUnlockPanel" Margin="0,12,0,0" Visibility="Collapsed">
					<Button
						Padding="28,10"
						Click="UnlockHello_Click"
						Content="Unlock with Windows Hello"
						Style="{StaticResource PrimaryButton}" />
				</StackPanel>

				<TextBlock
					x:Name="UnlockErrorText"
					Margin="0,14,0,0"
					HorizontalAlignment="Center"
					Foreground="{DynamicResource DangerBrush}"
					TextWrapping="Wrap"
					TextAlignment="Center" />
			</StackPanel>
		</Grid>

		<!-- Covers chrome until DB/dock init finishes — avoids black flash. -->
		<Border
			x:Name="StartupOverlay"
			Grid.RowSpan="4"
			Background="White"
			Panel.ZIndex="200">
			<syncfusion:SfBusyIndicator
				Width="120"
				Height="120"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				AnimationType="Cupertino"
				Header="Loading"
				IsBusy="True"
				ViewboxHeight="56"
				ViewboxWidth="56" />
		</Border>
	</Grid>
</Window>

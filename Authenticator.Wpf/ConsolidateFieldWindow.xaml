<Window x:Class="Authenticator.ConsolidateFieldWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Merge fields"
	Width="880"
	Height="600"
	MinWidth="600"
	MinHeight="420"
	WindowStartupLocation="CenterOwner"
	ShowInTaskbar="False"
	Loaded="Window_Loaded"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	FontFamily="Segoe UI"
	FontSize="14">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border Style="{StaticResource DialogHeader}">
			<Grid>
				<Button Content="Cancel"
					HorizontalAlignment="Left"
					IsCancel="True"
					Style="{StaticResource TextActionButton}"
					Click="Cancel_Click" />
				<TextBlock Text="Choose fields for survivor"
					FontSize="17"
					FontWeight="SemiBold"
					HorizontalAlignment="Center"
					VerticalAlignment="Center" />
			</Grid>
		</Border>

		<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,10,16,0">
			<Button Content="Soft-fill empties"
				Margin="0,0,8,0"
				Style="{StaticResource SecondaryButton}"
				Click="SoftFill_Click"
				ToolTip="For each empty survivor field, take the first non-empty donor value" />
			<Button Content="Automerge suggestion"
				Margin="0,0,8,0"
				Style="{StaticResource SecondaryButton}"
				Click="Automerge_Click"
				ToolTip="Newest non-empty value per field; distinct Notes are multi-merged" />
			<Button x:Name="RevealButton"
				Content="Reveal passwords"
				Margin="0,0,8,0"
				Style="{StaticResource SecondaryButton}"
				Click="Reveal_Click" />
			<TextBlock VerticalAlignment="Center"
				Foreground="{DynamicResource SecondaryTextBrush}"
				TextWrapping="Wrap"
				MaxWidth="480"
				Text="Created/Updated on columns · Click pick · Ctrl+click multi-merge · Edit overrides" />
		</StackPanel>

		<ScrollViewer Grid.Row="2"
			HorizontalScrollBarVisibility="Auto"
			VerticalScrollBarVisibility="Auto"
			Padding="16,12,16,0">
			<Border Style="{StaticResource DialogCard}" Padding="10">
				<Grid x:Name="MatrixHost" />
			</Border>
		</ScrollViewer>

		<Border Grid.Row="3" Style="{StaticResource DialogCard}" Margin="16,8,16,0" Padding="12">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock x:Name="EditFieldLabel"
					Text="Edit"
					VerticalAlignment="Center"
					Margin="0,0,10,0"
					FontWeight="SemiBold"
					MinWidth="80" />
				<TextBox x:Name="EditValueBox"
					Grid.Column="1"
					Style="{StaticResource DialogInput}"
					Padding="8,6"
					AcceptsReturn="True"
					TextWrapping="Wrap"
					MinHeight="36"
					VerticalScrollBarVisibility="Auto"
					LostKeyboardFocus="EditValueBox_LostFocus"
					ToolTip="Direct edit for the active field — overrides source picks" />
				<Button Grid.Column="2"
					Content="Apply edit"
					Margin="10,0,0,0"
					Style="{StaticResource SecondaryButton}"
					Click="ApplyEdit_Click" />
			</Grid>
		</Border>

		<Border Grid.Row="4" Style="{StaticResource DialogFooter}">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button Content="Cancel"
					Margin="0,0,8,0"
					Style="{StaticResource SecondaryButton}"
					IsCancel="True"
					Click="Cancel_Click" />
				<Button Content="Continue…"
					Style="{StaticResource PrimaryButton}"
					IsDefault="True"
					Click="Continue_Click" />
			</StackPanel>
		</Border>
	</Grid>
</Window>

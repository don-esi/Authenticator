<Window x:Class="Authenticator.PasswordGeneratorWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
	xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
	Title="Password generator"
	Width="420"
	Height="440"
	WindowStartupLocation="CenterOwner"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<TextBox x:Name="PasswordBox" FontFamily="Consolas" FontSize="16" Margin="0,0,0,12" IsReadOnly="True" />
		<StackPanel Grid.Row="1">
			<TextBlock Text="Length" />
			<syncfusion:IntegerTextBox
				x:Name="LengthBox"
				MinValue="8"
				MaxValue="64"
				Value="20"
				Margin="0,0,0,8"
				ValueChanged="LengthBox_ValueChanged" />
			<CheckBox x:Name="UpperCheck" Content="Uppercase" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed" />
			<CheckBox x:Name="LowerCheck" Content="Lowercase" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed" />
			<CheckBox x:Name="DigitsCheck" Content="Digits" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed" />
			<CheckBox x:Name="SymbolsCheck" Content="Symbols" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed" />
			<CheckBox x:Name="AmbiguousCheck" Content="Exclude ambiguous (0/O, 1/l/I)" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed" />
		</StackPanel>
		<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
			<syncfusion:ButtonAdv Label="Regenerate" Margin="0,0,8,0" Click="Regenerate_Click" SizeMode="Normal" />
			<syncfusion:ButtonAdv Label="Copy" Margin="0,0,8,0" Click="Copy_Click" SizeMode="Normal" />
			<syncfusion:ButtonAdv Label="Use" Click="Use_Click" SizeMode="Normal" />
		</StackPanel>
	</Grid>
</Window>

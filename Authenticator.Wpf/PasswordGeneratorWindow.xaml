<Window x:Class="Authenticator.PasswordGeneratorWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Password generator"
	Width="420"
	Height="480"
	MinWidth="380"
	MinHeight="420"
	WindowStartupLocation="CenterOwner"
	ShowInTaskbar="False"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	FontFamily="Segoe UI"
	FontSize="14">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border Style="{StaticResource DialogHeader}">
			<Grid>
				<Button Content="Cancel"
					HorizontalAlignment="Left"
					IsCancel="True"
					Style="{StaticResource TextActionButton}"
					AutomationProperties.Name="Cancel"
					Click="Cancel_Click" />
				<TextBlock Text="Password generator"
					FontSize="17"
					FontWeight="SemiBold"
					HorizontalAlignment="Center"
					VerticalAlignment="Center" />
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,16,8">
			<StackPanel>
				<Border Style="{StaticResource DialogCard}">
					<TextBox x:Name="PasswordBox"
						FontFamily="Consolas"
						FontSize="18"
						FontWeight="SemiBold"
						IsReadOnly="True"
						TextWrapping="Wrap"
						TextAlignment="Center"
						Style="{StaticResource DialogInput}"
						MinHeight="64"
						VerticalContentAlignment="Center"
						AutomationProperties.Name="Generated password" />
				</Border>

				<Border Style="{StaticResource DialogCard}" Margin="0,12,0,0">
					<StackPanel>
						<Grid Margin="0,0,0,4">
							<TextBlock Text="Length" Style="{StaticResource DialogLabel}" Margin="0" />
							<TextBlock x:Name="LengthValueText"
								Text="20"
								FontWeight="SemiBold"
								HorizontalAlignment="Right"
								Foreground="{DynamicResource BrandBlueBrush}" />
						</Grid>
						<Slider x:Name="LengthSlider"
							Minimum="8"
							Maximum="64"
							Value="20"
							IsSnapToTickEnabled="True"
							TickFrequency="1"
							Margin="0,0,0,16"
							ValueChanged="LengthSlider_ValueChanged"
							AutomationProperties.Name="Password length" />

						<CheckBox x:Name="UpperCheck"
							Content="Uppercase"
							IsChecked="True"
							Style="{StaticResource DialogCheck}"
							Checked="Options_Changed"
							Unchecked="Options_Changed" />
						<CheckBox x:Name="LowerCheck"
							Content="Lowercase"
							IsChecked="True"
							Style="{StaticResource DialogCheck}"
							Checked="Options_Changed"
							Unchecked="Options_Changed" />
						<CheckBox x:Name="DigitsCheck"
							Content="Digits"
							IsChecked="True"
							Style="{StaticResource DialogCheck}"
							Checked="Options_Changed"
							Unchecked="Options_Changed" />
						<CheckBox x:Name="SymbolsCheck"
							Content="Symbols"
							IsChecked="True"
							Style="{StaticResource DialogCheck}"
							Checked="Options_Changed"
							Unchecked="Options_Changed" />
						<CheckBox x:Name="AmbiguousCheck"
							Content="Exclude ambiguous (0/O, 1/l/I)"
							IsChecked="True"
							Style="{StaticResource DialogCheck}"
							Margin="0"
							Checked="Options_Changed"
							Unchecked="Options_Changed" />
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>

		<Border Grid.Row="2"
			Background="{DynamicResource NavBarBackgroundBrush}"
			BorderBrush="{DynamicResource BorderBrushColor}"
			BorderThickness="0,1,0,0"
			Padding="16,12">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button Content="Regenerate"
					Margin="0,0,8,0"
					Style="{StaticResource SecondaryButton}"
					Click="Regenerate_Click"
					AutomationProperties.Name="Regenerate" />
				<Button Content="Copy"
					Margin="0,0,8,0"
					Style="{StaticResource SecondaryButton}"
					Click="Copy_Click"
					AutomationProperties.Name="Copy" />
				<Button Content="Use"
					Style="{StaticResource PrimaryButton}"
					IsDefault="True"
					Click="Use_Click"
					AutomationProperties.Name="Use" />
			</StackPanel>
		</Border>
	</Grid>
</Window>

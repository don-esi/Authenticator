<Window x:Class="Authenticator.RecoveryKeyWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Vault recovery key"
	Width="520"
	SizeToContent="Height"
	WindowStartupLocation="CenterOwner"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	FontFamily="Segoe UI"
	FontSize="14">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border Style="{StaticResource DialogHeader}">
			<TextBlock Text="Vault recovery key"
				FontSize="17"
				FontWeight="SemiBold"
				HorizontalAlignment="Center"
				VerticalAlignment="Center" />
		</Border>

		<StackPanel Grid.Row="1" Margin="16,12,16,16">
			<Border Style="{StaticResource DialogCard}">
				<StackPanel>
					<TextBlock
						FontSize="16"
						FontWeight="SemiBold"
						Text="Save this recovery key offline"
						Margin="0,0,0,8" />
					<TextBlock
						TextWrapping="Wrap"
						Foreground="{DynamicResource SecondaryTextBrush}"
						Margin="0,0,0,12"
						Text="Shown once. You need it to enroll other machines on the shared vault. Store it somewhere safe — it cannot be retrieved again from this dialog." />
					<TextBox
						x:Name="KeyBox"
						IsReadOnly="True"
						TextWrapping="Wrap"
						AcceptsReturn="True"
						FontFamily="Consolas"
						FontSize="14"
						MinHeight="72"
						VerticalScrollBarVisibility="Auto"
						Style="{StaticResource DialogInput}"
						VerticalContentAlignment="Top"
						AutomationProperties.Name="Recovery key" />
					<TextBlock
						x:Name="CopyStatusText"
						FontSize="12"
						Foreground="{DynamicResource SecondaryTextBrush}"
						Margin="0,8,0,0"
						MinHeight="16" />
				</StackPanel>
			</Border>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
				<Button
					Content="Copy"
					Margin="0,0,8,0"
					Style="{StaticResource SecondaryButton}"
					Click="Copy_Click"
					AutomationProperties.Name="Copy" />
				<Button
					Content="I saved it"
					Style="{StaticResource PrimaryButton}"
					Click="Ok_Click"
					IsDefault="True"
					AutomationProperties.Name="I saved it" />
			</StackPanel>
		</StackPanel>
	</Grid>
</Window>

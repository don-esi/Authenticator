<Window x:Class="Authenticator.RecoveryKeyWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
	xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
	Title="Vault recovery key"
	Width="520"
	SizeToContent="Height"
	WindowStartupLocation="CenterOwner"
	ResizeMode="NoResize"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}">
	<StackPanel Margin="20">
		<TextBlock
			FontSize="16"
			FontWeight="SemiBold"
			Text="Save this recovery key offline"
			Margin="0,0,0,8" />
		<TextBlock
			TextWrapping="Wrap"
			Foreground="{DynamicResource SecondaryTextBrush}"
			Margin="0,0,0,12"
			Text="Shown once. You need it to enroll other machines on the shared vault. Store it somewhere safe — it cannot be retrieved again from this dialog." />
		<TextBox
			x:Name="KeyBox"
			IsReadOnly="True"
			TextWrapping="Wrap"
			AcceptsReturn="True"
			FontFamily="Consolas"
			FontSize="14"
			MinHeight="72"
			Padding="10,8"
			Margin="0,0,0,8"
			VerticalScrollBarVisibility="Auto"
			Background="{DynamicResource SecondaryBackgroundBrush}"
			Foreground="{DynamicResource PrimaryTextBrush}"
			CaretBrush="{DynamicResource PrimaryTextBrush}"
			BorderBrush="{DynamicResource BorderBrushColor}"
			AutomationProperties.Name="Recovery key" />
		<TextBlock
			x:Name="CopyStatusText"
			FontSize="12"
			Foreground="{DynamicResource SecondaryTextBrush}"
			Margin="0,0,0,12"
			MinHeight="16" />
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
			<syncfusion:ButtonAdv
				Label="Copy"
				Margin="0,0,8,0"
				Click="Copy_Click"
				SizeMode="Normal" />
			<syncfusion:ButtonAdv
				Label="I saved it"
				Click="Ok_Click"
				SizeMode="Normal"
				IsDefault="True" />
		</StackPanel>
	</StackPanel>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Authenticator</RootNamespace>
    <AssemblyName>Authenticator.Wpf</AssemblyName>
    <Platforms>AnyCPU</Platforms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
    <Product>Authenticator</Product>
    <Company>Authenticator</Company>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- Keep WinForms for NotifyIcon only; do not pollute global usings (WPF type clashes). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Drawing.Drawing2D" />
    <Using Remove="System.Drawing.Imaging" />
    <Using Remove="System.Drawing.Text" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Authenticator.Crypto\Authenticator.Crypto.csproj" />
    <ProjectReference Include="..\..\WealthForge\API\PasswordManager\PasswordManager.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="System.Formats.Cbor" Version="11.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageReference Include="Yubico.YubiKey" Version="1.18.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Syncfusion.Grid.WPF" Version="35.1.46" />
    <PackageReference Include="Syncfusion.SfGrid.WPF" Version="35.1.46" />
    <PackageReference Include="Syncfusion.Shared.WPF" Version="35.1.46" />
    <PackageReference Include="Syncfusion.Tools.WPF" Version="35.1.46" />
    <PackageReference Include="Syncfusion.SfInput.WPF" Version="35.1.46" />
    <PackageReference Include="Syncfusion.SfChromelessWindow.WPF" Version="35.1.46" />
    <PackageReference Include="Syncfusion.SfBusyIndicator.WPF" Version="35.1.46" />
    <PackageReference Include="Syncfusion.SfToastNotification.WPF" Version="35.1.46" />
    <PackageReference Include="Syncfusion.SfSkinManager.WPF" Version="35.1.46" />
  </ItemGroup>
</Project>

<Window
	x:Class="Authenticator.FirstRunWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Welcome to Authenticator"
	Width="440"
	Height="640"
	MinWidth="400"
	MinHeight="560"
	Icon="pack://application:,,,/Assets/app.ico"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	FontFamily="Segoe UI"
	FontSize="14"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterOwner"
	ShowInTaskbar="False">
	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,16">
			<TextBlock
				FontSize="24"
				FontWeight="SemiBold"
				Foreground="{DynamicResource PrimaryTextBrush}"
				Text="Set up Authenticator" />
			<TextBlock
				Margin="0,8,0,0"
				Foreground="{DynamicResource SecondaryTextBrush}"
				TextWrapping="Wrap"
				Text="Choose an unlock method to protect your codes. No Google account is required. You can optionally import a backup or a Google Authenticator export." />
		</StackPanel>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel>
				<TextBlock
					Margin="0,0,0,8"
					FontSize="12"
					Foreground="{DynamicResource SecondaryTextBrush}"
					Text="UNLOCK METHOD (REQUIRED)" />
				<Border
					Margin="0,0,0,16"
					Padding="16"
					Background="{DynamicResource CardBackgroundBrush}"
					CornerRadius="16">
					<StackPanel>
						<TextBlock
							x:Name="PinStatusText"
							Margin="0,0,0,8"
							FontWeight="SemiBold"
							Text="PIN: not set" />
						<PasswordBox
							x:Name="PinBox"
							Height="36"
							Margin="0,0,0,8"
							Padding="8,6"
							Background="{DynamicResource SecondaryBackgroundBrush}"
							Foreground="{DynamicResource PrimaryTextBrush}"
							CaretBrush="{DynamicResource PrimaryTextBrush}"
							AutomationProperties.Name="PIN" />
						<PasswordBox
							x:Name="PinConfirmBox"
							Height="36"
							Margin="0,0,0,8"
							Padding="8,6"
							Background="{DynamicResource SecondaryBackgroundBrush}"
							Foreground="{DynamicResource PrimaryTextBrush}"
							CaretBrush="{DynamicResource PrimaryTextBrush}"
							AutomationProperties.Name="Confirm PIN" />
						<Button
							Margin="0,0,0,12"
							Click="SetPin_Click"
							Content="Save PIN"
							Style="{StaticResource PrimaryButton}" />

						<StackPanel x:Name="HelloPanel" Visibility="Collapsed">
							<TextBlock
								x:Name="HelloStatusText"
								Margin="0,0,0,8"
								FontWeight="SemiBold"
								Text="Windows Hello: not enabled" />
							<Button
								Click="EnableHello_Click"
								Content="Enable Windows Hello"
								Style="{StaticResource SecondaryButton}" />
						</StackPanel>

						<TextBlock
							x:Name="StatusText"
							Margin="0,12,0,0"
							Foreground="{DynamicResource SecondaryTextBrush}"
							TextWrapping="Wrap" />
					</StackPanel>
				</Border>

				<TextBlock
					Margin="0,0,0,8"
					FontSize="12"
					Foreground="{DynamicResource SecondaryTextBrush}"
					Text="OPTIONAL IMPORT" />
				<Border
					Padding="16"
					Background="{DynamicResource CardBackgroundBrush}"
					CornerRadius="16">
					<StackPanel>
						<Button
							Margin="0,0,0,8"
							Click="ImportJson_Click"
							Content="Import JSON backup"
							Style="{StaticResource SecondaryButton}" />
						<TextBox
							x:Name="GoogleMigrationBox"
							Margin="0,0,0,8"
							AcceptsReturn="True"
							MinHeight="56"
							TextWrapping="Wrap"
							VerticalScrollBarVisibility="Auto"
							Style="{StaticResource FieldBox}"
							AutomationProperties.Name="Google migration URI" />
						<Button
							Click="ImportGoogleUri_Click"
							Content="Import Google Authenticator export URI"
							Style="{StaticResource SecondaryButton}" />
						<TextBlock
							x:Name="ImportStatusText"
							Margin="0,12,0,0"
							Foreground="{DynamicResource PrimaryTextBrush}"
							TextWrapping="Wrap" />
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>

		<Button
			x:Name="ContinueButton"
			Grid.Row="2"
			Margin="0,16,0,0"
			HorizontalAlignment="Stretch"
			Click="Continue_Click"
			Content="Continue"
			IsEnabled="False"
			Style="{StaticResource PrimaryButton}" />
	</Grid>
</Window>

<Window x:Class="Authenticator.ReconcileHistoryWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Reconcile history"
	Width="720"
	Height="480"
	MinWidth="560"
	MinHeight="360"
	WindowStartupLocation="CenterOwner"
	ShowInTaskbar="False"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	FontFamily="Segoe UI"
	FontSize="14">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border Style="{StaticResource DialogHeader}">
			<Grid>
				<Button Content="Close"
					HorizontalAlignment="Left"
					IsCancel="True"
					Style="{StaticResource TextActionButton}"
					Click="Close_Click"
					AutomationProperties.Name="Close" />
				<TextBlock x:Name="TitleText"
					Text="Reconcile history"
					FontSize="17"
					FontWeight="SemiBold"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					TextTrimming="CharacterEllipsis"
					MaxWidth="480" />
			</Grid>
		</Border>

		<TextBlock Grid.Row="1"
			Margin="16,10,16,0"
			Foreground="{DynamicResource SecondaryTextBrush}"
			TextWrapping="Wrap"
			Text="Undo restores the vault snapshot from before that Apply. Choose Update all to also push the restored values to linked providers." />

		<ListBox x:Name="HistoryList"
			Grid.Row="2"
			Margin="16,12,16,0"
			BorderThickness="1"
			BorderBrush="{DynamicResource BorderBrushColor}"
			Background="{DynamicResource SecondaryBackgroundBrush}"
			ScrollViewer.HorizontalScrollBarVisibility="Disabled">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<Grid Margin="8,6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel>
							<TextBlock FontWeight="SemiBold" Text="{Binding TitleLine}" TextWrapping="Wrap" />
							<TextBlock Margin="0,2,0,0"
								Foreground="{DynamicResource SecondaryTextBrush}"
								FontSize="12"
								Text="{Binding DetailLine}"
								TextWrapping="Wrap" />
						</StackPanel>
						<Button Grid.Column="1"
							Margin="12,0,0,0"
							Padding="10,4"
							VerticalAlignment="Center"
							Content="Undo"
							Style="{StaticResource SecondaryButton}"
							IsEnabled="{Binding CanUndo}"
							Tag="{Binding Id}"
							Click="Undo_Click"
							AutomationProperties.Name="Undo reconcile" />
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<Border Grid.Row="3" Style="{StaticResource DialogFooter}">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button Content="Refresh"
					Margin="0,0,8,0"
					Style="{StaticResource SecondaryButton}"
					Click="Refresh_Click"
					AutomationProperties.Name="Refresh history" />
				<Button Content="Close"
					Style="{StaticResource SecondaryButton}"
					Click="Close_Click"
					AutomationProperties.Name="Close" />
			</StackPanel>
		</Border>
	</Grid>
</Window>

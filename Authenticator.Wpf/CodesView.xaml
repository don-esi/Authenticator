<UserControl x:Class="Authenticator.CodesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             IsVisibleChanged="CodesView_IsVisibleChanged">
    <Grid Margin="20,16,20,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="2FA Codes"
                   FontSize="28"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,16" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="#F3F4F6" CornerRadius="12" Padding="12,8">
                <Grid>
                    <TextBlock x:Name="SearchHint"
                               Text="Search"
                               Foreground="#9CA3AF"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox"
                             AutomationProperties.Name="Search"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="15"
                             TextChanged="SearchBox_TextChanged" />
                </Grid>
            </Border>
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Style="{StaticResource IconButton}"
                    ToolTip="Add folder"
                    AutomationProperties.Name="Add folder"
                    Click="AddFolder_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#0078D4" Text="&#xE8F4;" />
            </Button>
            <Button x:Name="DeleteFolderButton"
                    Grid.Column="2"
                    Margin="4,0,0,0"
                    Visibility="Collapsed"
                    Style="{StaticResource SecondaryButton}"
                    Content="Delete folder"
                    Click="DeleteFolder_Click" />
        </Grid>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
            <StackPanel x:Name="ChipPanel" Orientation="Horizontal" />
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#6B7280" Margin="0,0,0,8" />

        <Grid Grid.Row="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AccountList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="14,12"
                                    Background="#F4F6FC"
                                    CornerRadius="16"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44"
                                            Height="44"
                                            CornerRadius="12"
                                            Background="{Binding InitialBrush}"
                                            VerticalAlignment="Top"
                                            Margin="0,2,12,0">
                                        <TextBlock Text="{Binding Initial}"
                                                   Foreground="White"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding ServiceName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Username}"
                                                   Foreground="#6B7280"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,6" />
                                        <TextBlock Text="{Binding DisplayCode}"
                                                   FontFamily="Consolas"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Style="{StaticResource ThinProgress}"
                                                         Maximum="{Binding Period}"
                                                         Value="{Binding SecondsRemaining}"
                                                         VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SecondsRemaining}"
                                                       Margin="10,0,0,0"
                                                       Foreground="#6B7280"
                                                       FontSize="13"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Tag="{Binding}"
                                                Click="Star_Click"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Favorite"
                                                AutomationProperties.Name="Favorite">
                                            <TextBlock Text="{Binding Star}"
                                                       FontSize="18"
                                                       Foreground="{Binding StarBrush}" />
                                        </Button>
                                        <Button Tag="{Binding}"
                                                Click="Copy_Click"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Copy code"
                                                AutomationProperties.Name="Copy code">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#0078D4" Text="&#xE8C8;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText"
                       Text="No accounts yet."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#6B7280"
                       FontSize="16"
                       Visibility="Collapsed" />
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,4,12"
                    Width="56"
                    Height="56"
                    Click="AddAccount_Click"
                    AutomationProperties.Name="Add account"
                    ToolTip="Add account"
                    Style="{StaticResource PrimaryButton}">
                <TextBlock Text="+" FontSize="28" Margin="0,-4,0,0" />
            </Button>
        </Grid>
    </Grid>
</UserControl>

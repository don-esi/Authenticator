<UserControl x:Class="Authenticator.CodesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{DynamicResource PrimaryTextBrush}"
             IsVisibleChanged="CodesView_IsVisibleChanged">
    <UserControl.Resources>
        <!-- Shared slide-action chrome for account rows -->
        <Style x:Key="AccountSlideHost" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="FavoriteStarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Favorite" />
        </Style>

        <DataTemplate x:Key="CondensedAccountTemplate">
            <Grid Style="{StaticResource AccountSlideHost}" Height="56">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch">
                    <Button Width="44" Margin="0,0,4,0" VerticalAlignment="Stretch" Tag="{Binding}"
                            Click="SlideCopy_Click" Style="{StaticResource SlideActionButton}"
                            Background="#0078D4" ToolTip="Copy code" AutomationProperties.Name="Copy code">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" Text="&#xE72D;" />
                    </Button>
                    <Button Width="44" Margin="0,0,4,0" VerticalAlignment="Stretch" Tag="{Binding}"
                            Click="SlideEdit_Click" Style="{StaticResource SlideActionButton}"
                            Background="#9CA3AF" ToolTip="Edit" AutomationProperties.Name="Edit account">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" Text="&#xE70F;" />
                    </Button>
                    <Button Width="44" VerticalAlignment="Stretch" Tag="{Binding}"
                            Click="SlideDelete_Click" Style="{StaticResource SlideActionButton}"
                            Background="#EF4444" ToolTip="Delete" AutomationProperties.Name="Delete account">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" Text="&#xE74D;" />
                    </Button>
                </StackPanel>
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Cursor="Hand" Padding="10,8"
                        Loaded="AccountSlide_Loaded"
                        MouseLeftButtonDown="Slide_MouseLeftButtonDown"
                        MouseMove="Slide_MouseMove"
                        MouseLeftButtonUp="Slide_MouseLeftButtonUp"
                        LostMouseCapture="Slide_LostMouseCapture">
                    <Border.RenderTransform>
                        <TranslateTransform X="0" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{Binding InitialBrush}"
                                VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding ServiceName}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Text="{Binding Username}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <ProgressBar Grid.Row="2" Margin="0,4,0,0" Style="{StaticResource ThinProgress}"
                                         Maximum="{Binding Period}" Value="{Binding SecondsRemaining}" />
                        </Grid>
                        <Button Grid.Column="2"
                                Style="{StaticResource FavoriteStarButton}"
                                Tag="{Binding}"
                                Click="Favorite_Click">
                            <TextBlock Text="{Binding Star}" Foreground="{Binding StarBrush}" FontSize="16" />
                        </Button>
                        <TextBlock Grid.Column="3" Text="{Binding DisplayCode}" FontFamily="Consolas"
                                   FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="4,0,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LargeAccountTemplate">
            <Grid Style="{StaticResource AccountSlideHost}" Height="96">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch">
                    <Button Width="44" Margin="0,0,4,0" VerticalAlignment="Stretch" Tag="{Binding}"
                            Click="SlideCopy_Click" Style="{StaticResource SlideActionButton}"
                            Background="#0078D4" ToolTip="Copy code" AutomationProperties.Name="Copy code">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" Text="&#xE72D;" />
                    </Button>
                    <Button Width="44" Margin="0,0,4,0" VerticalAlignment="Stretch" Tag="{Binding}"
                            Click="SlideEdit_Click" Style="{StaticResource SlideActionButton}"
                            Background="#9CA3AF" ToolTip="Edit" AutomationProperties.Name="Edit account">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" Text="&#xE70F;" />
                    </Button>
                    <Button Width="44" VerticalAlignment="Stretch" Tag="{Binding}"
                            Click="SlideDelete_Click" Style="{StaticResource SlideActionButton}"
                            Background="#EF4444" ToolTip="Delete" AutomationProperties.Name="Delete account">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" Text="&#xE74D;" />
                    </Button>
                </StackPanel>
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" Cursor="Hand" Padding="14,12"
                        Loaded="AccountSlide_Loaded"
                        MouseLeftButtonDown="Slide_MouseLeftButtonDown"
                        MouseMove="Slide_MouseMove"
                        MouseLeftButtonUp="Slide_MouseLeftButtonUp"
                        LostMouseCapture="Slide_LostMouseCapture">
                    <Border.RenderTransform>
                        <TranslateTransform X="0" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="12" Background="{Binding InitialBrush}"
                                VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding ServiceName}" FontWeight="SemiBold" FontSize="17"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Text="{Binding Username}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                            <ProgressBar Grid.Row="2" Margin="0,8,0,0" Height="4"
                                         Style="{StaticResource ThinProgress}"
                                         Maximum="{Binding Period}" Value="{Binding SecondsRemaining}" />
                        </Grid>
                        <Button Grid.Column="2"
                                Style="{StaticResource FavoriteStarButton}"
                                Tag="{Binding}"
                                Click="Favorite_Click">
                            <TextBlock Text="{Binding Star}" Foreground="{Binding StarBrush}" FontSize="18" />
                        </Button>
                        <TextBlock Grid.Column="3" Text="{Binding DisplayCode}" FontFamily="Consolas"
                                   FontSize="28" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="6,0,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SquareAccountTemplate">
            <Grid Width="176" Height="156" Margin="0,0,8,8" ClipToBounds="True">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch">
                    <Button Width="40" Margin="0,0,4,0" VerticalAlignment="Stretch" Tag="{Binding}"
                            Click="SlideCopy_Click" Style="{StaticResource SlideActionButton}"
                            Background="#0078D4" ToolTip="Copy code" AutomationProperties.Name="Copy code">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" Text="&#xE72D;" />
                    </Button>
                    <Button Width="40" Margin="0,0,4,0" VerticalAlignment="Stretch" Tag="{Binding}"
                            Click="SlideEdit_Click" Style="{StaticResource SlideActionButton}"
                            Background="#9CA3AF" ToolTip="Edit" AutomationProperties.Name="Edit account">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" Text="&#xE70F;" />
                    </Button>
                    <Button Width="40" VerticalAlignment="Stretch" Tag="{Binding}"
                            Click="SlideDelete_Click" Style="{StaticResource SlideActionButton}"
                            Background="#EF4444" ToolTip="Delete" AutomationProperties.Name="Delete account">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" Text="&#xE74D;" />
                    </Button>
                </StackPanel>
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" Cursor="Hand" Padding="12"
                        Loaded="AccountSlide_Loaded"
                        MouseLeftButtonDown="Slide_MouseLeftButtonDown"
                        MouseMove="Slide_MouseMove"
                        MouseLeftButtonUp="Slide_MouseLeftButtonUp"
                        LostMouseCapture="Slide_LostMouseCapture">
                    <Border.RenderTransform>
                        <TranslateTransform X="0" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border Width="40" Height="40" CornerRadius="10" Background="{Binding InitialBrush}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button HorizontalAlignment="Right"
                                    Style="{StaticResource FavoriteStarButton}"
                                    Tag="{Binding}"
                                    Click="Favorite_Click">
                                <TextBlock Text="{Binding Star}" Foreground="{Binding StarBrush}" FontSize="16" />
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,4">
                            <TextBlock Text="{Binding ServiceName}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                            <TextBlock Text="{Binding Username}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="{Binding DisplayCode}" FontFamily="Consolas"
                                   FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <ProgressBar Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource ThinProgress}"
                                     Maximum="{Binding Period}" Value="{Binding SecondsRemaining}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="ListAccountsPanel">
            <StackPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="SquareAccountsPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="16,12,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="2FA Codes"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,10" />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="10" Padding="10,6">
                <Grid>
                    <TextBlock x:Name="SearchHint"
                               Text="Search"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox"
                             AutomationProperties.Name="Search"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="14"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             CaretBrush="{DynamicResource PrimaryTextBrush}"
                             TextChanged="SearchBox_TextChanged" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="6,0,0,0"
                        Style="{StaticResource IconButton}"
                        ToolTip="Add folder"
                        AutomationProperties.Name="Add folder"
                        Click="AddFolder_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource BrandBlueBrush}" Text="&#xE8F4;" />
                </Button>
                <Button x:Name="ViewModeButton"
                        Margin="2,0,0,0"
                        Style="{StaticResource IconButton}"
                        ToolTip="View size"
                        AutomationProperties.Name="View size"
                        Click="ViewModeButton_Click">
                    <TextBlock x:Name="ViewModeIcon"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{DynamicResource BrandBlueBrush}"
                               Text="&#xE8C4;" />
                    <Button.ContextMenu>
                        <ContextMenu Opened="ViewModeMenu_Opened">
                            <MenuItem Header="Condensed" Tag="Condensed" Click="ViewModeMenuItem_Click" />
                            <MenuItem Header="Large" Tag="Large" Click="ViewModeMenuItem_Click" />
                            <MenuItem Header="Squares" Tag="Squares" Click="ViewModeMenuItem_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="SortButton"
                        Margin="2,0,0,0"
                        Style="{StaticResource IconButton}"
                        ToolTip="Sort"
                        AutomationProperties.Name="Sort accounts"
                        Click="SortButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource BrandBlueBrush}" Text="&#xE8CB;" />
                    <Button.ContextMenu>
                        <ContextMenu Opened="SortMenu_Opened">
                            <MenuItem Header="Latest First" Tag="LatestFirst" Click="SortMenuItem_Click" />
                            <MenuItem Header="Earliest First" Tag="EarliestFirst" Click="SortMenuItem_Click" />
                            <Separator />
                            <MenuItem Header="Service A &gt; Z" Tag="ServiceAsc" Click="SortMenuItem_Click" />
                            <MenuItem Header="Service Z &gt; A" Tag="ServiceDesc" Click="SortMenuItem_Click" />
                            <MenuItem Header="Account A &gt; Z" Tag="AccountAsc" Click="SortMenuItem_Click" />
                            <MenuItem Header="Account Z &gt; A" Tag="AccountDesc" Click="SortMenuItem_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel x:Name="ChipPanel" Margin="0,0,0,4" />
                    <ItemsControl x:Name="AccountList"
                                  ItemTemplate="{StaticResource CondensedAccountTemplate}"
                                  ItemsPanel="{StaticResource ListAccountsPanel}" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel x:Name="EmptyPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock x:Name="EmptyText"
                           Text="No accounts yet."
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="15" />
                <TextBlock x:Name="EmptyHint"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="13"
                           Text="Tap + to add an account" />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,4,10"
                    Width="48"
                    Height="48"
                    Click="AddAccount_Click"
                    AutomationProperties.Name="Add account"
                    ToolTip="Add account"
                    Style="{StaticResource PrimaryButton}">
                <TextBlock Text="+" FontSize="24" Margin="0,-2,0,0" />
            </Button>
            <Border x:Name="StatusToast"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,72"
                    Padding="18,10"
                    Background="{DynamicResource ToastBackgroundBrush}"
                    CornerRadius="20"
                    Opacity="0.92"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock x:Name="ToastText"
                           Text="Copied"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>
    </Grid>
</UserControl>

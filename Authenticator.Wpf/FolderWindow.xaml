<Window x:Class="Authenticator.FolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create folder"
        Height="280"
        Width="420"
        MinHeight="260"
        MinWidth="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8F9FA"
        FontFamily="Segoe UI"
        FontSize="14"
        Foreground="#1F2937"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Button Content="Cancel"
                        HorizontalAlignment="Left"
                        IsCancel="True"
                        Style="{StaticResource TextActionButton}"
                        AutomationProperties.Name="Cancel" />
                <TextBlock Text="Create folder"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Button x:Name="SaveButton"
                        Content="Save"
                        HorizontalAlignment="Right"
                        Style="{StaticResource TextActionButton}"
                        AutomationProperties.Name="Save"
                        Click="Save_Click" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="16">
            <Border Background="#F4F6FC" CornerRadius="16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Name" Foreground="#6B7280" />
                    <TextBox x:Name="NameBox"
                             Style="{StaticResource FieldBox}"
                             MaxLength="100"
                             Margin="0,2,0,12"
                             AutomationProperties.Name="Folder name" />
                    <TextBlock Text="Color" Foreground="#6B7280" Margin="0,0,0,8" />
                    <StackPanel x:Name="ColorPanel" Orientation="Horizontal" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="ErrorText"
                       Foreground="#B00020"
                       TextWrapping="Wrap"
                       Margin="4,12,4,0" />
        </StackPanel>
    </Grid>
</Window>

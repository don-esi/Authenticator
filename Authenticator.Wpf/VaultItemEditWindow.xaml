<Window x:Class="Authenticator.VaultItemEditWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
	xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
	Title="Vault item"
	Width="480"
	Height="560"
	WindowStartupLocation="CenterOwner"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}">
	<ScrollViewer Margin="16">
		<StackPanel>
			<TextBlock Text="Type" />
			<ComboBox x:Name="TypeBox" Margin="0,0,0,8" />
			<TextBlock Text="Title" />
			<TextBox x:Name="TitleBox" Margin="0,0,0,8" />
			<TextBlock Text="Username" />
			<TextBox x:Name="UserBox" Margin="0,0,0,8" />
			<TextBlock Text="Password" />
			<Grid Margin="0,0,0,8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBox x:Name="PassBox" />
				<syncfusion:ButtonAdv Grid.Column="1" Label="Reveal" Margin="4,0,0,0" Click="RevealPass_Click" SizeMode="Normal" />
				<syncfusion:ButtonAdv Grid.Column="2" Label="Gen" Margin="4,0,0,0" Click="Generate_Click" SizeMode="Normal" />
			</Grid>
			<TextBlock Text="URL" />
			<TextBox x:Name="UrlBox" Margin="0,0,0,8" />
			<TextBlock Text="Notes" />
			<TextBox x:Name="NotesBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8" />
			<TextBlock Text="TOTP secret (optional)" />
			<TextBox x:Name="TotpBox" Margin="0,0,0,8" />
			<TextBlock Text="Linked 2FA account id (optional)" />
			<TextBox x:Name="LinkedBox" Margin="0,0,0,8" />
			<CheckBox x:Name="FavoriteCheck" Content="Favorite" Margin="0,0,0,12" />
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<syncfusion:ButtonAdv Label="Cancel" Margin="0,0,8,0" IsCancel="True" SizeMode="Normal" Click="Cancel_Click" />
				<syncfusion:ButtonAdv Label="Save" Click="Save_Click" SizeMode="Normal" />
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</Window>

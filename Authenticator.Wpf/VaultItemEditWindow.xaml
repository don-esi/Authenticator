<Window x:Class="Authenticator.VaultItemEditWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Vault item"
	Width="480"
	Height="600"
	MinWidth="420"
	MinHeight="480"
	WindowStartupLocation="CenterOwner"
	ShowInTaskbar="False"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	FontFamily="Segoe UI"
	FontSize="14">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Border Style="{StaticResource DialogHeader}">
			<Grid>
				<Button Content="Cancel"
					HorizontalAlignment="Left"
					IsCancel="True"
					Style="{StaticResource TextActionButton}"
					AutomationProperties.Name="Cancel"
					Click="Cancel_Click" />
				<TextBlock Text="Vault item"
					FontSize="17"
					FontWeight="SemiBold"
					HorizontalAlignment="Center"
					VerticalAlignment="Center" />
				<Button Content="Save"
					HorizontalAlignment="Right"
					IsDefault="True"
					Style="{StaticResource TextActionButton}"
					FontWeight="SemiBold"
					AutomationProperties.Name="Save"
					Click="Save_Click" />
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,16,16">
			<StackPanel>
				<Border Style="{StaticResource DialogCard}">
					<StackPanel>
						<TextBlock Text="Type" Style="{StaticResource DialogLabel}" />
						<ComboBox x:Name="TypeBox"
							Style="{StaticResource DialogCombo}"
							Margin="0,0,0,12"
							AutomationProperties.Name="Type" />

						<TextBlock Text="Title" Style="{StaticResource DialogLabel}" />
						<TextBox x:Name="TitleBox"
							Style="{StaticResource DialogInput}"
							Margin="0,0,0,12"
							AutomationProperties.Name="Title" />

						<TextBlock Text="Username" Style="{StaticResource DialogLabel}" />
						<TextBox x:Name="UserBox"
							Style="{StaticResource DialogInput}"
							Margin="0,0,0,12"
							AutomationProperties.Name="Username" />

						<TextBlock Text="Password" Style="{StaticResource DialogLabel}" />
						<Grid Margin="0,0,0,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Grid>
								<PasswordBox x:Name="PassMasked"
									Style="{StaticResource DialogPassword}"
									AutomationProperties.Name="Password" />
								<!-- Shown when a stored password exists but is not yet revealed/edited. -->
								<TextBlock x:Name="PassPlaceholder"
									Text="••••••••••••"
									Margin="10,0,0,0"
									VerticalAlignment="Center"
									IsHitTestVisible="False"
									Visibility="Collapsed"
									Foreground="{DynamicResource SecondaryTextBrush}" />
							</Grid>
							<TextBox x:Name="PassPlain"
								Style="{StaticResource DialogInput}"
								Visibility="Collapsed"
								AutomationProperties.Name="Password (visible)" />
							<Button x:Name="RevealPassButton"
								Grid.Column="1"
								Content="Reveal"
								Margin="8,0,0,0"
								Style="{StaticResource SecondaryButton}"
								Click="RevealPass_Click"
								ToolTip="Show password"
								AutomationProperties.Name="Reveal password" />
							<Button Grid.Column="2"
								Content="Gen"
								Margin="8,0,0,0"
								Style="{StaticResource SecondaryButton}"
								Click="Generate_Click"
								ToolTip="Generate password"
								AutomationProperties.Name="Generate password" />
						</Grid>

						<TextBlock Text="URL" Style="{StaticResource DialogLabel}" />
						<TextBox x:Name="UrlBox"
							Style="{StaticResource DialogInput}"
							Margin="0,0,0,12"
							AutomationProperties.Name="URL" />

						<TextBlock Text="Linked sources (origin ids)" Style="{StaticResource DialogLabel}" />
						<TextBlock x:Name="LinkedSourcesText"
							FontSize="12"
							TextWrapping="Wrap"
							Foreground="{DynamicResource SecondaryTextBrush}"
							Text="None — saves to Shared only until imported/synced from a provider."
							AutomationProperties.Name="Linked sources" />
					</StackPanel>
				</Border>

				<Border Style="{StaticResource DialogCard}" Margin="0,12,0,0">
					<StackPanel>
						<TextBlock Text="Notes" Style="{StaticResource DialogLabel}" />
						<TextBox x:Name="NotesBox"
							Style="{StaticResource DialogInput}"
							Height="88"
							TextWrapping="Wrap"
							AcceptsReturn="True"
							VerticalScrollBarVisibility="Auto"
							VerticalContentAlignment="Top"
							Margin="0,0,0,12"
							AutomationProperties.Name="Notes" />

						<TextBlock Text="TOTP secret (optional)" Style="{StaticResource DialogLabel}" />
						<TextBox x:Name="TotpBox"
							Style="{StaticResource DialogInput}"
							Margin="0,0,0,12"
							AutomationProperties.Name="TOTP secret" />

						<TextBlock Text="Linked 2FA account id (optional)" Style="{StaticResource DialogLabel}" />
						<TextBox x:Name="LinkedBox"
							Style="{StaticResource DialogInput}"
							Margin="0,0,0,12"
							AutomationProperties.Name="Linked 2FA account id" />

						<CheckBox x:Name="FavoriteCheck"
							Content="Favorite"
							Style="{StaticResource DialogCheck}"
							Margin="0,0,0,8"
							AutomationProperties.Name="Favorite" />

						<CheckBox x:Name="AutoFillCheck"
							Content="Auto-fill"
							Style="{StaticResource DialogCheck}"
							Margin="0,0,0,4"
							ToolTip="When this login uniquely matches the browser tab domain, type username and password into the page."
							Checked="AutoFillCheck_Changed"
							Unchecked="AutoFillCheck_Changed"
							AutomationProperties.Name="Auto-fill" />
						<CheckBox x:Name="AutoLoginCheck"
							Content="Auto-login"
							Style="{StaticResource DialogCheck}"
							Margin="0"
							ToolTip="Also activate Next / Continue / Sign in buttons for multi-step username then password forms."
							AutomationProperties.Name="Auto-login" />
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>

<Window x:Class="Authenticator.AppDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Authenticator"
	Width="420"
	SizeToContent="Height"
	MinWidth="360"
	MaxWidth="520"
	WindowStartupLocation="CenterOwner"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	FontFamily="Segoe UI"
	FontSize="14">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border Style="{StaticResource DialogHeader}">
			<Grid>
				<TextBlock x:Name="TitleText"
					FontSize="17"
					FontWeight="SemiBold"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					TextTrimming="CharacterEllipsis"
					Text="Authenticator" />
			</Grid>
		</Border>

		<Border Grid.Row="1" Style="{StaticResource DialogCard}" Margin="16,12,16,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Border x:Name="IconChrome"
					Width="40"
					Height="40"
					CornerRadius="10"
					Margin="0,0,12,0"
					VerticalAlignment="Top"
					Background="{DynamicResource ChipIdleBrush}">
					<TextBlock x:Name="IconGlyph"
						FontFamily="Segoe MDL2 Assets"
						FontSize="18"
						Foreground="{DynamicResource BrandBlueBrush}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Text="&#xE946;" />
				</Border>
				<TextBlock x:Name="MessageText"
					Grid.Column="1"
					TextWrapping="Wrap"
					LineHeight="22"
					Foreground="{DynamicResource PrimaryTextBrush}"
					Text="" />
			</Grid>
		</Border>

		<Border Grid.Row="2" Style="{StaticResource DialogFooter}">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button x:Name="SecondaryButton"
					Content="Cancel"
					Margin="0,0,8,0"
					Style="{StaticResource SecondaryButton}"
					IsCancel="True"
					Click="Secondary_Click"
					AutomationProperties.Name="Cancel" />
				<Button x:Name="PrimaryButton"
					Content="OK"
					Style="{StaticResource PrimaryButton}"
					IsDefault="True"
					Click="Primary_Click"
					AutomationProperties.Name="OK" />
			</StackPanel>
		</Border>
	</Grid>
</Window>

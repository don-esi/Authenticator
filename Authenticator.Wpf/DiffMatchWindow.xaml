<Window x:Class="Authenticator.DiffMatchWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Reconcile"
	Width="920"
	Height="640"
	MinWidth="720"
	MinHeight="520"
	WindowStartupLocation="CenterOwner"
	ShowInTaskbar="False"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	FontFamily="Segoe UI"
	FontSize="14">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border Style="{StaticResource DialogHeader}">
			<Grid>
				<Button Content="Close"
					HorizontalAlignment="Left"
					IsCancel="True"
					Style="{StaticResource TextActionButton}"
					AutomationProperties.Name="Close"
					Click="Close_Click" />
				<TextBlock x:Name="TitleText"
					Text="Reconcile"
					FontSize="17"
					FontWeight="SemiBold"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					TextTrimming="CharacterEllipsis"
					MaxWidth="560" />
			</Grid>
		</Border>

		<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,10,16,0">
			<CheckBox x:Name="ShowPasswordsCheck"
				Content="Show passwords"
				VerticalAlignment="Center"
				Margin="0,0,16,0"
				Checked="ShowPasswords_Changed"
				Unchecked="ShowPasswords_Changed"
				AutomationProperties.Name="Show passwords" />
			<Button Content="Soft-fill empties"
				Margin="0,0,8,0"
				Style="{StaticResource SecondaryButton}"
				Click="SoftFill_Click"
				ToolTip="For each empty vault field, take the first non-empty provider value"
				AutomationProperties.Name="Soft-fill empties" />
			<TextBlock VerticalAlignment="Center"
				Foreground="{DynamicResource SecondaryTextBrush}"
				Text="Pick This is correct on a column, or click a field cell to choose that source." />
		</StackPanel>

		<ScrollViewer Grid.Row="2"
			HorizontalScrollBarVisibility="Auto"
			VerticalScrollBarVisibility="Auto"
			Padding="16,12,16,0">
			<Border Style="{StaticResource DialogCard}" Padding="10">
				<Grid x:Name="MatrixHost" />
			</Border>
		</ScrollViewer>

		<Border Grid.Row="3" Style="{StaticResource DialogFooter}">
			<Grid>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
					<Button x:Name="UnlinkSelectedButton"
						Content="Unlink selected provider"
						Style="{StaticResource SecondaryButton}"
						Click="UnlinkSelected_Click"
						ToolTip="Remove the selected provider link (not the same entry)"
						AutomationProperties.Name="Unlink selected provider" />
				</StackPanel>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<Button Content="Apply to vault…"
						Margin="0,0,8,0"
						Style="{StaticResource PrimaryButton}"
						Click="Apply_Click"
						AutomationProperties.Name="Apply to vault" />
					<Button Content="Close"
						Style="{StaticResource SecondaryButton}"
						Click="Close_Click"
						AutomationProperties.Name="Close" />
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</Window>

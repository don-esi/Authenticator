<Window x:Class="Authenticator.DiffMatchWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
	Title="Diff / match"
	Width="720"
	Height="520"
	MinWidth="560"
	MinHeight="400"
	WindowStartupLocation="CenterOwner"
	ShowInTaskbar="False"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	FontFamily="Segoe UI"
	FontSize="14">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border Style="{StaticResource DialogHeader}">
			<Grid>
				<Button Content="Close"
					HorizontalAlignment="Left"
					IsCancel="True"
					Style="{StaticResource TextActionButton}"
					AutomationProperties.Name="Close"
					Click="Close_Click" />
				<TextBlock x:Name="TitleText"
					Text="Diff / match"
					FontSize="17"
					FontWeight="SemiBold"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					TextTrimming="CharacterEllipsis"
					MaxWidth="480" />
			</Grid>
		</Border>

		<Border Grid.Row="1"
			Style="{StaticResource DialogCard}"
			Margin="16,12,16,0"
			Padding="8">
			<syncfusion:SfDataGrid
				x:Name="DiffGrid"
				AutoGenerateColumns="False"
				AllowEditing="False"
				AllowFiltering="False"
				AllowSorting="False"
				SelectionMode="Single"
				RowHeight="36"
				ColumnSizer="Star"
				BorderThickness="0"
				Background="Transparent">
				<syncfusion:SfDataGrid.Columns>
					<syncfusion:GridTextColumn HeaderText="Field" MappingName="Field" Width="120" ColumnSizer="None" />
					<syncfusion:GridTextColumn HeaderText="Shared" MappingName="Shared" MinimumWidth="120" />
					<syncfusion:GridTextColumn HeaderText="Provider" MappingName="Provider" MinimumWidth="120" />
					<syncfusion:GridTextColumn HeaderText="Status" MappingName="Status" Width="100" ColumnSizer="None" />
				</syncfusion:SfDataGrid.Columns>
			</syncfusion:SfDataGrid>
		</Border>

		<Border Grid.Row="2"
			Background="{DynamicResource NavBarBackgroundBrush}"
			BorderBrush="{DynamicResource BorderBrushColor}"
			BorderThickness="0,1,0,0"
			Padding="16,12"
			Margin="0,12,0,0">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button x:Name="SyncSharedButton"
					Content="Sync → Shared"
					Margin="0,0,8,0"
					Style="{StaticResource SecondaryButton}"
					Click="SyncShared_Click"
					AutomationProperties.Name="Sync to Shared" />
				<Button x:Name="SyncProviderButton"
					Content="Sync → Provider"
					Margin="0,0,8,0"
					Style="{StaticResource SecondaryButton}"
					Click="SyncProvider_Click"
					AutomationProperties.Name="Sync to Provider" />
				<Button Content="Close"
					Style="{StaticResource PrimaryButton}"
					Click="Close_Click"
					AutomationProperties.Name="Close" />
			</StackPanel>
		</Border>
	</Grid>
</Window>

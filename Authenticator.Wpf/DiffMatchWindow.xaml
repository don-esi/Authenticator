<Window x:Class="Authenticator.DiffMatchWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
	xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
	Title="Diff / match"
	Width="720"
	Height="520"
	WindowStartupLocation="CenterOwner"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}">
	<DockPanel Margin="12">
		<TextBlock DockPanel.Dock="Top" x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
			<syncfusion:ButtonAdv x:Name="SyncSharedButton" Label="Sync → Shared" Margin="0,0,8,0" Click="SyncShared_Click" SizeMode="Normal" />
			<syncfusion:ButtonAdv x:Name="SyncProviderButton" Label="Sync → Provider" Margin="0,0,8,0" Click="SyncProvider_Click" SizeMode="Normal" />
			<syncfusion:ButtonAdv Label="Close" Click="Close_Click" SizeMode="Normal" />
		</StackPanel>
		<syncfusion:SfDataGrid
			x:Name="DiffGrid"
			AutoGenerateColumns="False"
			AllowEditing="False"
			AllowFiltering="False"
			AllowSorting="False"
			SelectionMode="Single"
			RowHeight="32"
			ColumnSizer="Star">
			<syncfusion:SfDataGrid.Columns>
				<syncfusion:GridTextColumn HeaderText="Field" MappingName="Field" Width="120" ColumnSizer="None" />
				<syncfusion:GridTextColumn HeaderText="Shared" MappingName="Shared" MinimumWidth="120" />
				<syncfusion:GridTextColumn HeaderText="Provider" MappingName="Provider" MinimumWidth="120" />
				<syncfusion:GridTextColumn HeaderText="Status" MappingName="Status" Width="100" ColumnSizer="None" />
			</syncfusion:SfDataGrid.Columns>
		</syncfusion:SfDataGrid>
	</DockPanel>
</Window>

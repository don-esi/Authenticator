<Window x:Class="Authenticator.ConsolidateWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
	Title="Consolidate duplicates"
	Width="1040"
	Height="720"
	MinWidth="760"
	MinHeight="540"
	WindowStartupLocation="CenterOwner"
	ShowInTaskbar="False"
	Background="{DynamicResource PageBackgroundBrush}"
	Foreground="{DynamicResource PrimaryTextBrush}"
	FontFamily="Segoe UI"
	FontSize="14">
	<Window.Resources>
		<Style x:Key="ModeChip" TargetType="ToggleButton">
			<Setter Property="Padding" Value="12,6" />
			<Setter Property="Margin" Value="0,0,6,0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border x:Name="Bd"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="6"
							Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandBlueBrush}" />
								<Setter Property="Foreground" Value="White" />
								<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBlueBrush}" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Opacity" Value="0.92" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="ProviderFilterChip" TargetType="ToggleButton" BasedOn="{StaticResource ModeChip}">
			<Setter Property="Padding" Value="8,4" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Margin" Value="0,0,6,6" />
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border Style="{StaticResource DialogHeader}">
			<Grid>
				<Button Content="Close"
					HorizontalAlignment="Left"
					Style="{StaticResource TextActionButton}"
					Click="Close_Click"
					AutomationProperties.Name="Close" />
				<TextBlock x:Name="TitleText"
					Text="Consolidate duplicates"
					FontSize="17"
					FontWeight="SemiBold"
					HorizontalAlignment="Center"
					VerticalAlignment="Center" />
				<Button x:Name="RevealAllButton"
					Content="Reveal passwords"
					HorizontalAlignment="Right"
					Style="{StaticResource TextActionButton}"
					Click="RevealAll_Click"
					ToolTip="Show or hide passwords on all cards and in Select mode" />
			</Grid>
		</Border>

		<Grid Grid.Row="1" Margin="16,12,16,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<ToggleButton x:Name="ModeSuggested" Content="Suggested" Style="{StaticResource ModeChip}"
					Checked="Mode_Checked" Unchecked="Mode_Unchecked" />
				<ToggleButton x:Name="ModeBoard" Content="Board" Style="{StaticResource ModeChip}"
					Checked="Mode_Checked" Unchecked="Mode_Unchecked" />
				<ToggleButton x:Name="ModeSelect" Content="Select" Style="{StaticResource ModeChip}"
					Checked="Mode_Checked" Unchecked="Mode_Unchecked" />
			</StackPanel>

			<TextBox x:Name="SearchBox"
				Grid.Column="1"
				Margin="16,0,12,0"
				VerticalAlignment="Center"
				Style="{StaticResource DialogInput}"
				Padding="10,6"
				TextChanged="SearchBox_TextChanged"
				AutomationProperties.Name="Search vault items" />

			<TextBlock x:Name="HintText"
				Grid.Column="2"
				VerticalAlignment="Center"
				Foreground="{DynamicResource SecondaryTextBrush}"
				Text="Drag onto survivor" />
		</Grid>

		<DockPanel Grid.Row="2" Margin="16,8,16,0" LastChildFill="True">
			<TextBlock DockPanel.Dock="Left"
				Text="Providers"
				VerticalAlignment="Center"
				Margin="0,0,10,6"
				Foreground="{DynamicResource SecondaryTextBrush}" />
			<WrapPanel x:Name="ProviderFilterPanel" />
		</DockPanel>

		<Grid Grid.Row="3" Margin="16,8,16,0">
			<ScrollViewer x:Name="SuggestedHost"
				VerticalScrollBarVisibility="Auto"
				HorizontalScrollBarVisibility="Disabled"
				Visibility="Collapsed">
				<StackPanel x:Name="SuggestedPanel" />
			</ScrollViewer>

			<ScrollViewer x:Name="BoardHost"
				VerticalScrollBarVisibility="Auto"
				HorizontalScrollBarVisibility="Disabled"
				Visibility="Collapsed"
				AllowDrop="True">
				<WrapPanel x:Name="BoardPanel" />
			</ScrollViewer>

			<Grid x:Name="SelectHost" Visibility="Collapsed">
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<ListView x:Name="SelectList"
					SelectionMode="Extended"
					BorderThickness="1"
					BorderBrush="{DynamicResource BorderBrushColor}"
					Background="{DynamicResource SecondaryBackgroundBrush}"
					SelectionChanged="SelectList_SelectionChanged"
					MouseDoubleClick="SelectList_MouseDoubleClick"
					KeyDown="SelectList_KeyDown">
					<ListView.View>
						<GridView x:Name="SelectGridView">
							<GridViewColumn Width="200">
								<GridViewColumn.Header>
									<GridViewColumnHeader Content="Title" Tag="Title" Click="SortHeader_Click" />
								</GridViewColumn.Header>
								<GridViewColumn.DisplayMemberBinding>
									<Binding Path="Title" />
								</GridViewColumn.DisplayMemberBinding>
							</GridViewColumn>
							<GridViewColumn Width="160">
								<GridViewColumn.Header>
									<GridViewColumnHeader Content="Username" Tag="Username" Click="SortHeader_Click" />
								</GridViewColumn.Header>
								<GridViewColumn.DisplayMemberBinding>
									<Binding Path="Username" />
								</GridViewColumn.DisplayMemberBinding>
							</GridViewColumn>
							<GridViewColumn Width="140">
								<GridViewColumn.Header>
									<GridViewColumnHeader Content="Password" Tag="Password" Click="SortHeader_Click" />
								</GridViewColumn.Header>
								<GridViewColumn.DisplayMemberBinding>
									<Binding Path="PasswordDisplay" />
								</GridViewColumn.DisplayMemberBinding>
							</GridViewColumn>
							<GridViewColumn Width="140">
								<GridViewColumn.Header>
									<GridViewColumnHeader Content="Host" Tag="Host" Click="SortHeader_Click" />
								</GridViewColumn.Header>
								<GridViewColumn.DisplayMemberBinding>
									<Binding Path="Host" />
								</GridViewColumn.DisplayMemberBinding>
							</GridViewColumn>
							<GridViewColumn Width="140">
								<GridViewColumn.Header>
									<GridViewColumnHeader Content="Providers" Tag="Providers" Click="SortHeader_Click" />
								</GridViewColumn.Header>
								<GridViewColumn.DisplayMemberBinding>
									<Binding Path="Providers" />
								</GridViewColumn.DisplayMemberBinding>
							</GridViewColumn>
							<GridViewColumn Width="120">
								<GridViewColumn.Header>
									<GridViewColumnHeader Content="Created" Tag="Created" Click="SortHeader_Click" />
								</GridViewColumn.Header>
								<GridViewColumn.DisplayMemberBinding>
									<Binding Path="CreatedDisplay" />
								</GridViewColumn.DisplayMemberBinding>
							</GridViewColumn>
							<GridViewColumn Width="120">
								<GridViewColumn.Header>
									<GridViewColumnHeader Content="Updated" Tag="Updated" Click="SortHeader_Click" />
								</GridViewColumn.Header>
								<GridViewColumn.DisplayMemberBinding>
									<Binding Path="UpdatedDisplay" />
								</GridViewColumn.DisplayMemberBinding>
							</GridViewColumn>
							<GridViewColumn Width="100">
								<GridViewColumn.Header>
									<GridViewColumnHeader Content="Suggestion" Tag="Suggestion" Click="SortHeader_Click" />
								</GridViewColumn.Header>
								<GridViewColumn.DisplayMemberBinding>
									<Binding Path="Suggestion" />
								</GridViewColumn.DisplayMemberBinding>
							</GridViewColumn>
						</GridView>
					</ListView.View>
				</ListView>
				<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
					<Button Content="Merge…"
						Style="{StaticResource PrimaryButton}"
						Margin="0,0,8,0"
						Click="SelectMerge_Click"
						ToolTip="Merge selected rows (offers automerge suggestion first)" />
					<Button Content="Edit…"
						Style="{StaticResource SecondaryButton}"
						Margin="0,0,8,0"
						Click="SelectEdit_Click"
						ToolTip="Edit the selected vault item" />
					<Button Content="Delete…"
						Style="{StaticResource SecondaryButton}"
						Click="SelectDelete_Click"
						ToolTip="Soft-delete selected vault items" />
					<TextBlock x:Name="SelectHint"
						Margin="12,0,0,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource SecondaryTextBrush}"
						Text="Suggestion = automerge survivor · Created/Updated sortable" />
				</StackPanel>
			</Grid>
		</Grid>

		<Border Grid.Row="4" Style="{StaticResource DialogFooter}">
			<Grid>
				<TextBlock x:Name="StatusText"
					VerticalAlignment="Center"
					Foreground="{DynamicResource SecondaryTextBrush}"
					TextWrapping="Wrap"
					MaxWidth="700" />
				<Button Content="Close"
					HorizontalAlignment="Right"
					Style="{StaticResource SecondaryButton}"
					Click="Close_Click"
					AutomationProperties.Name="Close consolidate" />
			</Grid>
		</Border>

		<!-- Shown while loading / revealing / connecting providers so the dialog does not look frozen. -->
		<Border
			x:Name="BusyOverlay"
			Grid.RowSpan="5"
			Background="#99FFFFFF"
			Panel.ZIndex="50"
			Visibility="Collapsed"
			IsHitTestVisible="True">
			<syncfusion:SfBusyIndicator
				x:Name="BusyIndicator"
				Width="160"
				Height="160"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				AnimationType="Cupertino"
				Header="Working…"
				IsBusy="False"
				ViewboxHeight="56"
				ViewboxWidth="56" />
		</Border>
	</Grid>
</Window>

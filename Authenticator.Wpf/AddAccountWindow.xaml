<Window x:Class="Authenticator.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add account"
        Height="760"
        Width="520"
        MinHeight="480"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8F9FA"
        FontFamily="Segoe UI"
        FontSize="14"
        Foreground="#1F2937"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Button Content="Cancel"
                        HorizontalAlignment="Left"
                        IsCancel="True"
                        Style="{StaticResource TextActionButton}"
                        AutomationProperties.Name="Cancel" />
                <TextBlock x:Name="TitleText"
                           Text="Add account"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Button x:Name="SaveButton"
                        Content="Save"
                        HorizontalAlignment="Right"
                        Style="{StaticResource TextActionButton}"
                        AutomationProperties.Name="Save"
                        Click="Save_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,16,16">
            <StackPanel>
                <Border Background="#F4F6FC" CornerRadius="16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Service name" Foreground="#6B7280" />
                        <TextBox x:Name="ServiceNameBox"
                                 Style="{StaticResource FieldBox}"
                                 MaxLength="200"
                                 Margin="0,2,0,8"
                                 AutomationProperties.Name="Service name" />
                        <Border Height="1" Background="#E5E7EB" Margin="0,0,0,8" />

                        <TextBlock Text="URL" Foreground="#6B7280" />
                        <TextBox x:Name="ServiceUrlBox"
                                 Style="{StaticResource FieldBox}"
                                 MaxLength="500"
                                 Margin="0,2,0,8"
                                 AutomationProperties.Name="URL" />
                        <Border Height="1" Background="#E5E7EB" Margin="0,0,0,8" />

                        <TextBlock Text="Username" Foreground="#6B7280" />
                        <TextBox x:Name="UsernameBox"
                                 Style="{StaticResource FieldBox}"
                                 MaxLength="200"
                                 Margin="0,2,0,8"
                                 AutomationProperties.Name="Username" />
                        <Border Height="1" Background="#E5E7EB" Margin="0,0,0,8" />

                        <TextBlock Text="Secret key" Foreground="#6B7280" />
                        <TextBox x:Name="SecretKeyBox"
                                 Style="{StaticResource FieldBox}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="56"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,2,0,8"
                                 AutomationProperties.Name="Secret key" />
                        <Border Height="1" Background="#E5E7EB" Margin="0,0,0,8" />

                        <TextBlock Text="Folder" Foreground="#6B7280" />
                        <ComboBox x:Name="FolderBox"
                                  Margin="0,6,0,0"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="FolderBox_SelectionChanged"
                                  AutomationProperties.Name="Folder" />
                    </StackPanel>
                </Border>

                <Border Background="#F4F6FC" CornerRadius="16" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Advanced options" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Algorithm" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="2">
                                <StackPanel x:Name="AlgorithmPanel" Orientation="Horizontal" />
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Digits" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="2">
                                <StackPanel x:Name="DigitsPanel" Orientation="Horizontal" />
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Period" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="2">
                                <StackPanel x:Name="PeriodPanel" Orientation="Horizontal" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#F4F6FC" CornerRadius="16" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Backup codes" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="One code per line. A code that was already used stays used if you leave the line."
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,8" />
                        <TextBox x:Name="BackupCodesBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="120"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8"
                                 AutomationProperties.Name="Backup codes" />
                    </StackPanel>
                </Border>

                <Border Background="#F4F6FC" CornerRadius="16" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="QR code" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Paste an otpauth:// link, choose an image, or drag around a QR code on the screen."
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,8" />
                        <TextBox x:Name="OtpAuthBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="72"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8"
                                 AutomationProperties.Name="otpauth URI" />
                        <Button Content="Fill from link"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource SecondaryButton}"
                                AutomationProperties.Name="Fill from link"
                                Click="FillFromLink_Click" />
                        <Button Content="Decode QR image"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource SecondaryButton}"
                                AutomationProperties.Name="Decode QR image"
                                Click="DecodeImage_Click" />
                        <Button Content="Capture QR"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource SecondaryButton}"
                                AutomationProperties.Name="Capture QR"
                                Click="CaptureQr_Click" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText"
                           Foreground="#B00020"
                           TextWrapping="Wrap"
                           Margin="4,12,4,0" />

                <Button x:Name="DeleteButton"
                        Content="Delete account"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        Foreground="#B00020"
                        Style="{StaticResource TextActionButton}"
                        AutomationProperties.Name="Delete account"
                        Click="Delete_Click" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--  Brand Colors  -->
	<Color x:Key="BrandBlueColor">#0078D4</Color>
	<Color x:Key="BrandBlueLightColor">#50A8E5</Color>
	<Color x:Key="BrandBlueDarkColor">#005A9E</Color>

	<!--  Background Colors  -->
	<Color x:Key="PageBackgroundColor">#F8F9FA</Color>
	<Color x:Key="CardBackgroundColor">#F4F6FC</Color>
	<Color x:Key="SecondaryBackgroundColor">#F3F4F6</Color>

	<!--  Text Colors  -->
	<Color x:Key="PrimaryTextColor">#1F2937</Color>
	<Color x:Key="SecondaryTextColor">#6B7280</Color>
	<Color x:Key="TertiaryTextColor">#9CA3AF</Color>

	<!--  Border Colors  -->
	<Color x:Key="BorderColor">#E5E7EB</Color>
	<Color x:Key="DividerColor">#F3F4F6</Color>

	<!--  Folder Colors (Pastels)  -->
	<Color x:Key="FolderTealColor">#4ECDC4</Color>
	<Color x:Key="FolderMintColor">#95E1D3</Color>
	<Color x:Key="FolderPeriwinkleColor">#A8DADC</Color>
	<Color x:Key="FolderCoralColor">#F38181</Color>
	<Color x:Key="FolderOrangeColor">#FFA987</Color>
	<Color x:Key="FolderPurpleColor">#B8A4D4</Color>
	<Color x:Key="FolderLavenderColor">#C7CEEA</Color>
	<Color x:Key="FolderPeachColor">#FFD3B6</Color>

	<!--  State Colors  -->
	<Color x:Key="SuccessColor">#10B981</Color>
	<Color x:Key="ErrorColor">#EF4444</Color>
	<Color x:Key="WarningColor">#F59E0B</Color>

	<!--  Brushes  -->
	<SolidColorBrush x:Key="BrandBlueBrush" Color="{StaticResource BrandBlueColor}" />
	<SolidColorBrush x:Key="BrandBlueLightBrush" Color="{StaticResource BrandBlueLightColor}" />
	<SolidColorBrush x:Key="BrandBlueDarkBrush" Color="{StaticResource BrandBlueDarkColor}" />

	<SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}" />
	<SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
	<SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />

	<SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
	<SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
	<SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryTextColor}" />

	<SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
	<SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

	<SolidColorBrush x:Key="FolderTealBrush" Color="{StaticResource FolderTealColor}" />
	<SolidColorBrush x:Key="FolderMintBrush" Color="{StaticResource FolderMintColor}" />
	<SolidColorBrush x:Key="FolderPeriwinkleBrush" Color="{StaticResource FolderPeriwinkleColor}" />
	<SolidColorBrush x:Key="FolderCoralBrush" Color="{StaticResource FolderCoralColor}" />
	<SolidColorBrush x:Key="FolderOrangeBrush" Color="{StaticResource FolderOrangeColor}" />
	<SolidColorBrush x:Key="FolderPurpleBrush" Color="{StaticResource FolderPurpleColor}" />
	<SolidColorBrush x:Key="FolderLavenderBrush" Color="{StaticResource FolderLavenderColor}" />
	<SolidColorBrush x:Key="FolderPeachBrush" Color="{StaticResource FolderPeachColor}" />

	<SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
	<SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
	<SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

	<!--  Typography  -->
	<x:Double x:Key="LargeTitleFontSize">32</x:Double>
	<x:Double x:Key="TitleFontSize">24</x:Double>
	<x:Double x:Key="SubtitleFontSize">20</x:Double>
	<x:Double x:Key="BodyFontSize">14</x:Double>
	<x:Double x:Key="CaptionFontSize">12</x:Double>
	<x:Double x:Key="SmallCaptionFontSize">10</x:Double>

	<!--  Code Display (Monospace)  -->
	<x:Double x:Key="CodeFontSize">32</x:Double>
	<FontFamily x:Key="CodeFontFamily">Consolas, Courier New, monospace</FontFamily>

	<!--  Spacing  -->
	<x:Double x:Key="SpacingXSmall">4</x:Double>
	<x:Double x:Key="SpacingSmall">8</x:Double>
	<x:Double x:Key="SpacingMedium">12</x:Double>
	<x:Double x:Key="SpacingLarge">16</x:Double>
	<x:Double x:Key="SpacingXLarge">24</x:Double>
	<x:Double x:Key="SpacingXXLarge">32</x:Double>

	<!--  Corner Radius  -->
	<CornerRadius x:Key="SmallCornerRadius">4</CornerRadius>
	<CornerRadius x:Key="MediumCornerRadius">8</CornerRadius>
	<CornerRadius x:Key="LargeCornerRadius">12</CornerRadius>
	<CornerRadius x:Key="XLargeCornerRadius">16</CornerRadius>
</ResourceDictionary>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="Colors.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  Card Style  -->
	<Style x:Key="CardStyle" TargetType="Border">
		<Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{StaticResource MediumCornerRadius}" />
		<Setter Property="Padding" Value="{StaticResource SpacingLarge}" />
		<!--  Shadow removed - use Translation and Shadow property at control level for WinUI 3  -->
	</Style>

	<!--  Primary Button Style (Vibrant Blue)  -->
	<Style x:Key="PrimaryButtonStyle" TargetType="Button">
		<Setter Property="Background" Value="{StaticResource BrandBlueBrush}" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Padding" Value="24,12" />
		<Setter Property="CornerRadius" Value="{StaticResource MediumCornerRadius}" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
	</Style>

	<!--  Secondary Button Style  -->
	<Style x:Key="SecondaryButtonStyle" TargetType="Button">
		<Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
		<Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Padding" Value="24,12" />
		<Setter Property="CornerRadius" Value="{StaticResource MediumCornerRadius}" />
	</Style>

	<!--  Icon Button Style  -->
	<Style x:Key="IconButtonStyle" TargetType="Button">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
		<Setter Property="Padding" Value="8" />
		<Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}" />
		<Setter Property="Width" Value="40" />
		<Setter Property="Height" Value="40" />
	</Style>

	<!--  FAB (Floating Action Button) Style  -->
	<Style x:Key="FabButtonStyle" TargetType="Button">
		<Setter Property="Background" Value="{StaticResource BrandBlueBrush}" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="Width" Value="56" />
		<Setter Property="Height" Value="56" />
		<Setter Property="CornerRadius" Value="28" />
		<Setter Property="FontSize" Value="24" />
		<!--  Shadow removed - use Translation and Shadow property at control level for WinUI 3  -->
	</Style>

	<!--  Search Box Style  -->
	<Style x:Key="SearchBoxStyle" TargetType="TextBox">
		<Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
		<Setter Property="PlaceholderForeground" Value="{StaticResource TertiaryTextBrush}" />
		<Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="CornerRadius" Value="20" />
		<Setter Property="Height" Value="40" />
	</Style>

	<!--  Service Name Text Style  -->
	<Style x:Key="ServiceNameTextStyle" TargetType="TextBlock">
		<Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
	</Style>

	<!--  Username Text Style  -->
	<Style x:Key="UsernameTextStyle" TargetType="TextBlock">
		<Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
		<Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
	</Style>

	<!--  Code Text Style (Large Monospace)  -->
	<Style x:Key="CodeTextStyle" TargetType="TextBlock">
		<Setter Property="FontSize" Value="{StaticResource CodeFontSize}" />
		<Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
	</Style>

	<!--  Section Header Style  -->
	<Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
		<Setter Property="FontSize" Value="{StaticResource SubtitleFontSize}" />
		<Setter Property="FontWeight" Value="Bold" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
		<Setter Property="Margin" Value="0,0,0,12" />
	</Style>

	<!--  Page Title Style  -->
	<Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
		<Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
		<Setter Property="FontWeight" Value="Bold" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
	</Style>

	<!--  Divider Style  -->
	<Style x:Key="DividerStyle" TargetType="Border">
		<Setter Property="Background" Value="{StaticResource DividerBrush}" />
		<Setter Property="Height" Value="1" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
	</Style>

</ResourceDictionary>


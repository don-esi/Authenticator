{
  "manifest_version": 3,
  "name": "Authenticator Vault",
  "version": "1.0.0",
  "description": "Auto-fill logins from the local Authenticator vault (Chrome, Edge, Firefox).",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "authenticator@local",
      "strict_min_version": "121.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Authenticator Vault",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

<Page
	x:Class="Authenticator.Views.AddAccountPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Background="{StaticResource PageBackgroundBrush}">

	<Page.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Styles/Colors.xaml" />
				<ResourceDictionary Source="/Styles/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:InverseBoolConverter xmlns:converters="using:Authenticator.Converters" x:Key="InverseBoolConverter"/>
		</ResourceDictionary>
	</Page.Resources>

	<Grid>
		<!-- Top Bar -->
		<Grid Height="56"
			  VerticalAlignment="Top"
			  Background="{StaticResource CardBackgroundBrush}"
			  BorderBrush="{StaticResource BorderBrush}"
			  BorderThickness="0,0,0,1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Button Grid.Column="0"
					Click="CancelButton_Click"
					Style="{StaticResource IconButtonStyle}"
					Margin="12,0,0,0">
				<FontIcon Glyph="&#xE72B;" FontSize="16" />
			</Button>

			<TextBlock Grid.Column="1"
					   Text="Add Account"
					   Style="{StaticResource PageTitleTextStyle}"
					   VerticalAlignment="Center"
					   Margin="12,0" />

			<Button Grid.Column="2"
					Content="Save"
					Click="SaveButton_Click"
					Style="{StaticResource PrimaryButtonStyle}"
					Padding="20,8"
					Margin="0,0,12,0"
					IsEnabled="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
		</Grid>

		<!-- Form Content -->
		<ScrollViewer Margin="0,56,0,0" Padding="24,20">
			<StackPanel Spacing="20" MaxWidth="600">
				<!-- Website Name -->
				<StackPanel Spacing="8">
					<TextBlock Text="Service Name *" FontWeight="SemiBold" />
					<TextBox Text="{x:Bind ViewModel.ServiceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							 PlaceholderText="e.g. Google, GitHub, LastPass" />
				</StackPanel>

				<!-- Website Address -->
				<StackPanel Spacing="8">
					<TextBlock Text="Service URL (Optional)" FontWeight="SemiBold" />
					<TextBox Text="{x:Bind ViewModel.ServiceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							 PlaceholderText="https://example.com" />
				</StackPanel>

				<!-- Username -->
				<StackPanel Spacing="8">
					<TextBlock Text="Username *" FontWeight="SemiBold" />
					<TextBox Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							 PlaceholderText="your.email@example.com" />
				</StackPanel>

				<!-- Folder -->
				<StackPanel Spacing="8">
					<TextBlock Text="Folder (Optional)" FontWeight="SemiBold" />
					<ComboBox ItemsSource="{x:Bind ViewModel.FolderOptions}"
							  SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}"
							  DisplayMemberPath="Name"
							  PlaceholderText="Choose a folder"
							  HorizontalAlignment="Stretch" />
				</StackPanel>

				<!-- Secret Key -->
				<StackPanel Spacing="8">
					<TextBlock Text="Secret Key (Seed) *" FontWeight="SemiBold" />
					<TextBox Text="{x:Bind ViewModel.SecretKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							 PlaceholderText="Base32 encoded secret key"
							 Height="80"
							 TextWrapping="Wrap"
							 AcceptsReturn="True" />
				</StackPanel>

				<!-- Advanced Options -->
				<Expander Header="Advanced Options"
						  IsExpanded="{x:Bind ViewModel.ShowAdvancedOptions, Mode=TwoWay}"
						  HorizontalAlignment="Stretch">
					<StackPanel Spacing="16" Padding="0,12,0,0">
						<!-- Algorithm -->
						<StackPanel Spacing="8">
							<TextBlock Text="Algorithm" FontWeight="SemiBold" />
							<ComboBox ItemsSource="{x:Bind ViewModel.AlgorithmOptions}"
									  SelectedItem="{x:Bind ViewModel.SelectedAlgorithm, Mode=TwoWay}"
									  HorizontalAlignment="Stretch" />
						</StackPanel>

						<!-- Digits -->
						<StackPanel Spacing="8">
							<TextBlock Text="Digits" FontWeight="SemiBold" />
							<ComboBox ItemsSource="{x:Bind ViewModel.DigitOptions}"
									  SelectedItem="{x:Bind ViewModel.SelectedDigits, Mode=TwoWay}"
									  HorizontalAlignment="Stretch" />
						</StackPanel>

						<!-- Period -->
						<StackPanel Spacing="8">
							<TextBlock Text="Period (seconds)" FontWeight="SemiBold" />
							<ComboBox ItemsSource="{x:Bind ViewModel.PeriodOptions}"
									  SelectedItem="{x:Bind ViewModel.SelectedPeriod, Mode=TwoWay}"
									  HorizontalAlignment="Stretch" />
						</StackPanel>
					</StackPanel>
				</Expander>

				<!-- Backup Codes -->
				<Expander Header="Backup Codes"
						  IsExpanded="{x:Bind ViewModel.EnableBackupCodes, Mode=TwoWay}"
						  HorizontalAlignment="Stretch">
					<StackPanel Spacing="12" Padding="0,12,0,0">
						<TextBlock Text="Add backup/recovery codes for this account (one per line):"
								   TextWrapping="Wrap"
								   Foreground="{StaticResource SecondaryTextBrush}" />

						<TextBox Text="{x:Bind ViewModel.BackupCodesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								 PlaceholderText="Enter backup codes here (one per line)"
								 Height="150"
								 TextWrapping="Wrap"
								 AcceptsReturn="True"
								 ScrollViewer.VerticalScrollBarVisibility="Auto" />

						<Button Command="{x:Bind ViewModel.ReadBackupCodesFromFileCommand}"
								Style="{StaticResource PrimaryButtonStyle}"
								HorizontalAlignment="Stretch">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<FontIcon Glyph="&#xE8E5;" FontSize="16" />
								<TextBlock Text="Read Backup Codes from File" />
							</StackPanel>
						</Button>
					</StackPanel>
				</Expander>

				<!-- QR Import Actions -->
				<StackPanel Spacing="8">
					<Button Style="{StaticResource SecondaryButtonStyle}"
							HorizontalAlignment="Stretch"
							Click="ScanQrCodeButton_Click">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<FontIcon Glyph="&#xE91B;" FontSize="16" />
							<TextBlock Text="Import From QR Image" />
						</StackPanel>
					</Button>

					<Button Style="{StaticResource SecondaryButtonStyle}"
							HorizontalAlignment="Stretch"
							Click="ScanQrFromScreenButton_Click">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<FontIcon Glyph="&#xE722;" FontSize="16" />
							<TextBlock Text="Scan QR From Screen" />
						</StackPanel>
					</Button>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Page>
<Page
	x:Class="Authenticator.Views.SettingsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Background="{StaticResource PageBackgroundBrush}"
	mc:Ignorable="d">

	<Grid>
		<Grid.Resources>
			<ResourceDictionary>
				<ResourceDictionary.MergedDictionaries>
					<ResourceDictionary Source="/Styles/Colors.xaml" />
					<ResourceDictionary Source="/Styles/Styles.xaml" />
				</ResourceDictionary.MergedDictionaries>
			</ResourceDictionary>
		</Grid.Resources>

		<ScrollViewer>
			<StackPanel Padding="24,20" Spacing="20">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<StackPanel>
						<TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Settings" />
						<TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Manage data storage, backup metrics, and application behavior." />
					</StackPanel>
					<Button
						Grid.Column="1"
						Padding="16,8"
						Click="RefreshButton_Click"
						Content="Refresh"
						Style="{StaticResource SecondaryButtonStyle}" />
				</Grid>

				<Border Style="{StaticResource CardStyle}">
					<StackPanel Spacing="16">
						<TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Data Storage" />
						<Grid ColumnSpacing="16" RowSpacing="12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Accounts" />
							<TextBlock
								x:Name="AccountsCountTextBlock"
								Grid.Column="1"
								HorizontalAlignment="Right"
								FontWeight="SemiBold"
								Text="0" />

							<TextBlock
								Grid.Row="1"
								Foreground="{StaticResource SecondaryTextBrush}"
								Text="Available backup codes" />
							<TextBlock
								x:Name="BackupCodesCountTextBlock"
								Grid.Row="1"
								Grid.Column="1"
								HorizontalAlignment="Right"
								FontWeight="SemiBold"
								Text="0" />

							<TextBlock
								Grid.Row="2"
								Foreground="{StaticResource SecondaryTextBrush}"
								Text="Trash items" />
							<TextBlock
								x:Name="TrashCountTextBlock"
								Grid.Row="2"
								Grid.Column="1"
								HorizontalAlignment="Right"
								FontWeight="SemiBold"
								Text="0" />
						</Grid>
					</StackPanel>
				</Border>

				<Border Style="{StaticResource CardStyle}">
					<StackPanel Spacing="16">
						<TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Security" />
						<Grid ColumnSpacing="16" RowSpacing="12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<StackPanel>
								<TextBlock FontWeight="SemiBold" Text="Auto Lock Timeout" />
								<TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Lock the app after inactivity." />
							</StackPanel>
							<ComboBox
								x:Name="AutoLockComboBox"
								Grid.Column="1"
								Width="180"
								SelectionChanged="AutoLockComboBox_SelectionChanged">
								<ComboBoxItem Content="Never" Tag="0" />
								<ComboBoxItem Content="30 seconds" Tag="30" />
								<ComboBoxItem Content="1 minute" Tag="60" />
								<ComboBoxItem Content="5 minutes" Tag="300" />
								<ComboBoxItem Content="15 minutes" Tag="900" />
							</ComboBox>
						</Grid>

						<Grid ColumnSpacing="16">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<StackPanel>
								<TextBlock FontWeight="SemiBold" Text="Sync Time with Internet" />
								<TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Improve TOTP accuracy using internet time sync." />
							</StackPanel>
							<ToggleSwitch
								x:Name="SyncTimeToggleSwitch"
								Grid.Column="1"
								Toggled="SyncTimeToggleSwitch_Toggled" />
						</Grid>
					</StackPanel>
				</Border>

				<Border Style="{StaticResource CardStyle}">
					<StackPanel Spacing="16">
						<TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Maintenance" />
						<TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Permanently remove deleted accounts and password entries from local storage." />
						<Button
							Padding="16,8"
							HorizontalAlignment="Left"
							Click="EmptyTrashButton_Click"
							Content="Empty Trash"
							Style="{StaticResource PrimaryButtonStyle}" />
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Page>

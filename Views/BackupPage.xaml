<Page
	x:Class="Authenticator.Views.BackupPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Background="{StaticResource PageBackgroundBrush}"
	mc:Ignorable="d">

	<Grid>
		<Grid.Resources>
			<ResourceDictionary>
				<ResourceDictionary.MergedDictionaries>
					<ResourceDictionary Source="/Styles/Colors.xaml" />
					<ResourceDictionary Source="/Styles/Styles.xaml" />
				</ResourceDictionary.MergedDictionaries>
			</ResourceDictionary>
		</Grid.Resources>

		<ScrollViewer>
			<StackPanel Padding="24,20" Spacing="20">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<StackPanel>
						<TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Backup" />
						<TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Review backup and recovery codes for your accounts." />
					</StackPanel>
					<Button
						Grid.Column="1"
						Padding="16,8"
						Click="RefreshButton_Click"
						Content="Refresh"
						Style="{StaticResource SecondaryButtonStyle}" />
				</Grid>

				<Grid ColumnSpacing="16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0" Style="{StaticResource CardStyle}">
						<StackPanel Spacing="6">
							<TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Accounts with backup codes" />
							<TextBlock
								x:Name="AccountsCountTextBlock"
								Style="{StaticResource PageTitleTextStyle}"
								Text="0" />
						</StackPanel>
					</Border>

					<Border Grid.Column="1" Style="{StaticResource CardStyle}">
						<StackPanel Spacing="6">
							<TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Available codes" />
							<TextBlock
								x:Name="AvailableCodesTextBlock"
								Style="{StaticResource PageTitleTextStyle}"
								Text="0" />
						</StackPanel>
					</Border>

					<Border Grid.Column="2" Style="{StaticResource CardStyle}">
						<StackPanel Spacing="6">
							<TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="Used codes" />
							<TextBlock
								x:Name="UsedCodesTextBlock"
								Style="{StaticResource PageTitleTextStyle}"
								Text="0" />
						</StackPanel>
					</Border>
				</Grid>

				<Grid ColumnSpacing="16" RowSpacing="16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="3*" />
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0" Style="{StaticResource CardStyle}">
						<StackPanel Spacing="12">
							<TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Accounts" />
							<ListView
								x:Name="AccountsListView"
								MinHeight="320"
								SelectionChanged="AccountsListView_SelectionChanged"
								SelectionMode="Single">
								<ListView.ItemTemplate>
									<DataTemplate>
										<StackPanel Padding="0,8" Spacing="2">
											<TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
											<TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Subtitle}" />
											<TextBlock
												FontSize="12"
												Foreground="{StaticResource SecondaryTextBrush}"
												Text="{Binding Summary}" />
										</StackPanel>
									</DataTemplate>
								</ListView.ItemTemplate>
							</ListView>
						</StackPanel>
					</Border>

					<Border Grid.Column="1" Style="{StaticResource CardStyle}">
						<StackPanel Spacing="12">
							<TextBlock
								x:Name="SelectedAccountTitleTextBlock"
								Style="{StaticResource SectionHeaderTextStyle}"
								Text="Backup Codes" />
							<TextBlock
								x:Name="SelectedAccountSubtitleTextBlock"
								Foreground="{StaticResource SecondaryTextBrush}"
								Text="Select an account to review backup codes." />
							<ListView x:Name="BackupCodesListView" MinHeight="320">
								<ListView.ItemTemplate>
									<DataTemplate>
										<Grid Padding="0,8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<StackPanel>
												<TextBlock
													FontFamily="Consolas"
													FontSize="16"
													FontWeight="SemiBold"
													Text="{Binding Code}" />
												<TextBlock
													FontSize="12"
													Foreground="{StaticResource SecondaryTextBrush}"
													Text="{Binding StatusText}" />
											</StackPanel>
											<Button
												Grid.Column="1"
												Margin="8,0,0,0"
												Padding="12,6"
												Click="CopyCodeButton_Click"
												Content="Copy"
												Style="{StaticResource SecondaryButtonStyle}"
												Tag="{Binding Code}" />
											<Button
												Grid.Column="2"
												Margin="8,0,0,0"
												Padding="12,6"
												Click="MarkUsedButton_Click"
												Content="Mark Used"
												IsEnabled="{Binding CanMarkUsed}"
												Style="{StaticResource PrimaryButtonStyle}"
												Tag="{Binding Id}" />
										</Grid>
									</DataTemplate>
								</ListView.ItemTemplate>
							</ListView>
						</StackPanel>
					</Border>
				</Grid>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Page>

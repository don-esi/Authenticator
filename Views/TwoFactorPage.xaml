<Page
	x:Class="Authenticator.Views.TwoFactorPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Authenticator.Controls"
	xmlns:converters="using:Authenticator.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Background="{StaticResource PageBackgroundBrush}"
	mc:Ignorable="d">

	<Page.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Styles/Colors.xaml" />
				<ResourceDictionary Source="/Styles/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
			<converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
			<converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
			<converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
			<converters:ViewModeIconConverter x:Key="ViewModeIconConverter" />
		</ResourceDictionary>
	</Page.Resources>

	<Grid>
		<!--  Main Content  -->
		<ScrollViewer>
			<StackPanel Padding="24,16,24,80" Spacing="20">
				<!--  Top Bar: Search, View Toggle, Sort  -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<!--  Search Box  -->
					<TextBox
						Grid.Column="0"
						Margin="0,0,12,0"
						PlaceholderText="Search accounts..."
						Style="{StaticResource SearchBoxStyle}"
						Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
						<TextBox.Resources>
							<controls:FluentIcon Favorite="Search" FontSize="16" x:Key="SearchIcon" />
						</TextBox.Resources>
					</TextBox>

					<!--  View Toggle Button  -->
					<Button
						Grid.Column="1"
						Margin="0,0,8,0"
						Command="{x:Bind ViewModel.ToggleViewModeCommand}"
						Style="{StaticResource IconButtonStyle}"
						ToolTipService.ToolTip="Toggle view">
						<controls:FluentIcon FontSize="16" Symbol="{x:Bind ViewModel.IsGridView, Mode=OneWay, Converter={StaticResource ViewModeIconConverter}}" />
					</Button>

					<!--  Sort Dropdown  -->
					<DropDownButton
						Grid.Column="2"
						AutomationProperties.Name="Sort"
						ToolTipService.ToolTip="Sort">
						<DropDownButton.Content>
							<controls:FluentIcon Favorite="Sort" />
						</DropDownButton.Content>
						<DropDownButton.Flyout>
							<MenuFlyout Placement="BottomEdgeAlignedLeft">
								<MenuFlyoutItem
									Command="{x:Bind ViewModel.SetSortOptionCommand}"
									CommandParameter="Latest First"
									Text="Latest First" />
								<MenuFlyoutItem
									Command="{x:Bind ViewModel.SetSortOptionCommand}"
									CommandParameter="Earliest First"
									Text="Earliest First" />
								<MenuFlyoutItem
									Command="{x:Bind ViewModel.SetSortOptionCommand}"
									CommandParameter="Service A→Z"
									Text="Service A→Z" />
								<MenuFlyoutItem
									Command="{x:Bind ViewModel.SetSortOptionCommand}"
									CommandParameter="Service Z→A"
									Text="Service Z→A" />
								<MenuFlyoutItem
									Command="{x:Bind ViewModel.SetSortOptionCommand}"
									CommandParameter="Account A→Z"
									Text="Account A→Z" />
								<MenuFlyoutItem
									Command="{x:Bind ViewModel.SetSortOptionCommand}"
									CommandParameter="Account Z→A"
									Text="Account Z→A" />
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
				</Grid>

				<!--  Folders Section  -->
				<StackPanel Spacing="12">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Folders" />
						<Button
							Grid.Column="1"
							Margin="0,0,8,0"
							Padding="12,6"
							Click="RenameFolderButton_Click"
							Content="Rename"
							FontSize="12"
							Style="{StaticResource SecondaryButtonStyle}"
							Visibility="{x:Bind ViewModel.SelectedFolder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
						<Button
							Grid.Column="2"
							Margin="0,0,8,0"
							Padding="12,6"
							Click="DeleteFolderButton_Click"
							Content="Delete"
							FontSize="12"
							Style="{StaticResource SecondaryButtonStyle}"
							Visibility="{x:Bind ViewModel.SelectedFolder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
						<Button
							Grid.Column="3"
							Padding="12,6"
							HorizontalAlignment="Right"
							Click="CreateFolderButton_Click"
							FontSize="12"
							Style="{StaticResource SecondaryButtonStyle}"
							ToolTipService.ToolTip="Create folder">
							<FontIcon
								FontFamily="Segoe Fluent Icons"
								FontSize="18"
								Glyph="&#xE8F4;" />
						</Button>
					</Grid>

					<TextBlock
						Foreground="{StaticResource SecondaryTextBrush}"
						Text="No folders yet. Create one to organize accounts."
						Visibility="{x:Bind ViewModel.Folders.Count, Mode=OneWay, Converter={StaticResource ZeroToVisibilityConverter}}" />

					<!--  Folder Chips with Horizontal Scroll  -->
					<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
						<StackPanel Orientation="Horizontal">
							<!--  All Accounts Chip  -->
							<Button
								Margin="0,0,8,0"
								Padding="16,8"
								Background="{StaticResource SecondaryBackgroundBrush}"
								BorderThickness="0"
								Command="{x:Bind ViewModel.ClearFolderFilterCommand}"
								CornerRadius="20">
								<Button.Content>
									<StackPanel Orientation="Horizontal" Spacing="8">
										<controls:FluentIcon Favorite="Home" FontSize="16" />
										<!--<FontIcon FontSize="16" Glyph="&#xE80F;" />-->
										<TextBlock
											FontSize="14"
											FontWeight="SemiBold"
											Text="All Accounts" />
									</StackPanel>
								</Button.Content>
							</Button>

							<!--  Folder Chips  -->
							<ItemsControl ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<controls:FolderChip Click="FolderChip_Click" FolderData="{Binding}" />
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</ScrollViewer>
				</StackPanel>

				<!--  Selected Folder Indicator  -->
				<StackPanel
					Orientation="Horizontal"
					Spacing="8"
					Visibility="{x:Bind ViewModel.SelectedFolder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
					<TextBlock
						FontSize="12"
						Foreground="{StaticResource SecondaryTextBrush}"
						Text="Filtering by:" />
					<TextBlock
						FontSize="12"
						FontWeight="SemiBold"
						Foreground="{StaticResource PrimaryTextBrush}"
						Text="{x:Bind ViewModel.SelectedFolder.Name, Mode=OneWay}" />
					<HyperlinkButton
						Padding="4,0"
						Command="{x:Bind ViewModel.ClearFolderFilterCommand}"
						Content="Clear"
						FontSize="12" />
				</StackPanel>

				<!--  Accounts List/Grid  -->
				<StackPanel Spacing="8">
					<TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Accounts" />

					<!--  List View  -->
					<ItemsControl ItemsSource="{x:Bind ViewModel.FilteredAccounts, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsGridView, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<controls:AccountCard
									AccountData="{Binding Account}"
									CopyRequested="AccountCard_CopyRequested"
									CurrentCode="{Binding CurrentCode, Mode=OneWay}"
									MoreRequested="AccountCard_MoreRequested"
									Progress="{Binding Progress, Mode=OneWay}"
									SecondsRemaining="{Binding SecondsRemaining, Mode=OneWay}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!--  Grid View  -->
					<GridView
						ItemsSource="{x:Bind ViewModel.FilteredAccounts, Mode=OneWay}"
						SelectionMode="None"
						Visibility="{x:Bind ViewModel.IsGridView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
						<GridView.ItemTemplate>
							<DataTemplate>
								<controls:AccountCard
									Width="360"
									AccountData="{Binding Account}"
									CopyRequested="AccountCard_CopyRequested"
									CurrentCode="{Binding CurrentCode, Mode=OneWay}"
									MoreRequested="AccountCard_MoreRequested"
									Progress="{Binding Progress, Mode=OneWay}"
									SecondsRemaining="{Binding SecondsRemaining, Mode=OneWay}" />
							</DataTemplate>
						</GridView.ItemTemplate>
					</GridView>

					<!--  Empty State  -->
					<StackPanel
						Margin="0,40"
						HorizontalAlignment="Center"
						Spacing="12"
						Visibility="{x:Bind ViewModel.FilteredAccounts.Count, Mode=OneWay, Converter={StaticResource ZeroToVisibilityConverter}}">
						<FontIcon
							FontSize="64"
							Foreground="{StaticResource TertiaryTextBrush}"
							Glyph="&#xE192;" />
						<TextBlock
							HorizontalAlignment="Center"
							FontSize="16"
							Foreground="{StaticResource SecondaryTextBrush}"
							Text="No accounts found" />
						<Button
							HorizontalAlignment="Center"
							Click="AddAccountButton_Click"
							Content="Add Your First Account"
							Style="{StaticResource PrimaryButtonStyle}" />
					</StackPanel>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>

		<!--  Floating Action Button (FAB)  -->
		<Button
			Margin="0,0,24,24"
			HorizontalAlignment="Right"
			VerticalAlignment="Bottom"
			Click="AddAccountButton_Click"
			Style="{StaticResource FabButtonStyle}">
			<controls:FluentIcon FontSize="24" Symbol="Add" />
		</Button>
	</Grid>
</Page>
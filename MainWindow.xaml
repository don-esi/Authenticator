<?xml version="1.0" encoding="utf-8" ?>
<Window
	x:Class="Authenticator.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:Authenticator"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="Authenticator"
	mc:Ignorable="d">

	<Grid Background="{StaticResource PageBackgroundBrush}">
		<Grid.Resources>
			<ResourceDictionary>
				<ResourceDictionary.MergedDictionaries>
					<ResourceDictionary Source="/Styles/Colors.xaml" />
					<ResourceDictionary Source="/Styles/Styles.xaml" />
				</ResourceDictionary.MergedDictionaries>
			</ResourceDictionary>
		</Grid.Resources>

		<Grid RowDefinitions="Auto,*,Auto">
			<Grid
				Grid.Row="0"
				Padding="16,8"
				Background="{StaticResource PageBackgroundBrush}">
				<TextBlock
					HorizontalAlignment="Center"
					Style="{StaticResource PageTitleTextStyle}"
					Text="2FA Codes" />
			</Grid>

			<Grid Grid.Row="1" RowDefinitions="Auto,*">
				<Frame
					x:Name="SimpleContentFrame"
					Grid.Row="1"
					Margin="0" />
			</Grid>

			<NavigationView
				x:Name="NavView"
				Grid.Row="2"
				Background="{StaticResource PageBackgroundBrush}"
				IsBackButtonVisible="Collapsed"
				IsSettingsVisible="False"
				PaneDisplayMode="Top"
				SelectionChanged="NavView_SelectionChanged">
				<NavigationView.MenuItems>
					<NavigationViewItem Content="2FA" Tag="TwoFactor" HorizontalAlignment="Left">
						<NavigationViewItem.Icon>
							<FontIcon Glyph="&#xE192;" />
						</NavigationViewItem.Icon>
					</NavigationViewItem>
					<NavigationViewItem Content="Backup" Tag="Backup" HorizontalAlignment="Center">
						<NavigationViewItem.Icon>
							<FontIcon Glyph="&#xE777;" />
						</NavigationViewItem.Icon>
					</NavigationViewItem>
					<NavigationViewItem Content="Settings" Tag="Settings" HorizontalAlignment="Right">
						<NavigationViewItem.Icon>
							<FontIcon Glyph="&#xE713;" />
						</NavigationViewItem.Icon>
					</NavigationViewItem>
				</NavigationView.MenuItems>
			</NavigationView>
		</Grid>
	</Grid>
</Window>
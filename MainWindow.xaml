<?xml version="1.0" encoding="utf-8" ?>
<Window
	x:Class="Authenticator.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:Authenticator"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="Authenticator"
	mc:Ignorable="d">

	<Grid Background="{StaticResource PageBackgroundBrush}" RequestedTheme="Light">
		<Grid.Resources>
			<ResourceDictionary>
				<ResourceDictionary.MergedDictionaries>
					<ResourceDictionary Source="/Styles/Colors.xaml" />
					<ResourceDictionary Source="/Styles/Styles.xaml" />
				</ResourceDictionary.MergedDictionaries>
			</ResourceDictionary>
		</Grid.Resources>

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid
				Grid.Row="0"
				Padding="16,8"
				Background="{StaticResource PageBackgroundBrush}">
				<TextBlock
					HorizontalAlignment="Center"
					Style="{StaticResource PageTitleTextStyle}"
					Text="2FA Codes" />
			</Grid>

			<Grid Grid.Row="1">
				<Frame
					x:Name="SimpleContentFrame"
					Grid.Row="1"
					Margin="0" />
			</Grid>

			<NavigationView
				x:Name="NavView"
				Grid.Row="2"
				Background="{StaticResource PageBackgroundBrush}"
				Foreground="{StaticResource PrimaryTextBrush}"
				IsBackButtonVisible="Collapsed"
				IsSettingsVisible="True"
				PaneDisplayMode="Top"
				SelectionChanged="NavView_SelectionChanged">
				<NavigationView.MenuItems>
					<!--  2FA  -->
					<NavigationViewItem Content="" Tag="TwoFactor">
						<NavigationViewItem.Icon>
							<FontIcon
								FontFamily="Segoe Fluent Icons"
								FontSize="24"
								Glyph="&#xE192;" />
						</NavigationViewItem.Icon>
					</NavigationViewItem>
					<!--  Backup  -->
					<NavigationViewItem Content="" Tag="Backup">
						<NavigationViewItem.Icon>
							<FontIcon
								FontFamily="Segoe Fluent Icons"
								FontSize="24"
								Glyph="&#xE777;" />
						</NavigationViewItem.Icon>
					</NavigationViewItem>
				</NavigationView.MenuItems>
			</NavigationView>
		</Grid>
	</Grid>
</Window>
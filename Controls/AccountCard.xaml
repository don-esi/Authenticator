<UserControl
	x:Class="Authenticator.Controls.AccountCard"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="using:Authenticator.Controls"
	xmlns:converters="using:Authenticator.Converters"
	mc:Ignorable="d">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Styles/Colors.xaml"/>
				<ResourceDictionary Source="/Styles/Styles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
			<converters:FirstLetterConverter x:Key="FirstLetterConverter"/>
		</ResourceDictionary>
	</UserControl.Resources>

	<Border Style="{StaticResource CardStyle}" 
			Padding="16,12"
			Margin="0,0,0,8">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="48"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<!-- Service Icon/Logo -->
			<Border Grid.Column="0"
					Width="40" Height="40"
					Background="{StaticResource BrandBlueBrush}"
					CornerRadius="20"
					VerticalAlignment="Center">
				<TextBlock Text="{x:Bind AccountData.ServiceName, Mode=OneWay, FallbackValue='?', TargetNullValue='?', Converter={StaticResource FirstLetterConverter}}"
						   FontSize="18"
						   FontWeight="SemiBold"
						   Foreground="White"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"/>
			</Border>

			<!-- Service Info and Code -->
			<StackPanel Grid.Column="1" 
						Margin="12,0,0,0"
						VerticalAlignment="Center">
				<!-- Service Name -->
				<TextBlock Text="{x:Bind AccountData.ServiceName, Mode=OneWay}"
						   Style="{StaticResource ServiceNameTextStyle}"/>

				<!-- Username -->
				<TextBlock Text="{x:Bind AccountData.Username, Mode=OneWay}"
						   Style="{StaticResource UsernameTextStyle}"
						   Margin="0,2,0,8"/>

				<!-- TOTP Code -->
				<TextBlock Text="{x:Bind CurrentCode, Mode=OneWay}"
						   Style="{StaticResource CodeTextStyle}"
						   FontSize="24"
						   Margin="0,0,0,4"/>

				<!-- Progress Bar -->
				<controls:TotpProgressBar 
					Progress="{x:Bind Progress, Mode=OneWay}"
					SecondsRemaining="{x:Bind SecondsRemaining, Mode=OneWay}"
					Width="200"
					HorizontalAlignment="Left"/>
			</StackPanel>

			<!-- Backup Codes Indicator -->
			<StackPanel Grid.Column="2" 
						Orientation="Horizontal"
						VerticalAlignment="Center"
						Margin="12,0">
				<FontIcon Glyph="&#xE192;" 
						  FontSize="16"
						  Foreground="{StaticResource SecondaryTextBrush}"/>
				<TextBlock Text="{x:Bind AccountData.BackupCodes.Count, Mode=OneWay}"
						   FontSize="12"
						   Foreground="{StaticResource SecondaryTextBrush}"
						   Margin="4,0,0,0"
						   VerticalAlignment="Center"/>
			</StackPanel>

			<!-- Action Buttons -->
			<StackPanel Grid.Column="3" 
						Orientation="Horizontal"
						VerticalAlignment="Center">
				<Button Style="{StaticResource IconButtonStyle}"
						Click="CopyButton_Click"
						ToolTipService.ToolTip="Copy code">
					<FontIcon Glyph="&#xE8C8;" FontSize="16"/>
				</Button>
				<Button Style="{StaticResource IconButtonStyle}"
						Click="MoreButton_Click"
						ToolTipService.ToolTip="More options">
					<FontIcon Glyph="&#xE712;" FontSize="16"/>
				</Button>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>

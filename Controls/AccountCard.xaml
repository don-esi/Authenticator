<UserControl
	x:Class="Authenticator.Controls.AccountCard"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Authenticator.Controls"
	xmlns:converters="using:Authenticator.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Styles/Colors.xaml" />
				<ResourceDictionary Source="/Styles/Styles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<converters:FirstLetterConverter x:Key="FirstLetterConverter" />
		</ResourceDictionary>
	</UserControl.Resources>

	<Border
		Margin="0,0,0,0"
		Padding="4,4"
		Background="{StaticResource CardBackgroundBrush}"
		Style="{StaticResource CardStyle}">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="48" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<!--  Service Icon/Logo  -->
			<Border
				Grid.Column="0"
				Width="40"
				Height="40"
				Margin="0,0,0,0"
				VerticalAlignment="Center"
				Background="{StaticResource BrandBlueBrush}"
				CornerRadius="20">
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="18"
					FontWeight="SemiBold"
					Foreground="White"
					Text="{x:Bind AccountData.ServiceName, Mode=OneWay, FallbackValue='?', TargetNullValue='?', Converter={StaticResource FirstLetterConverter}}" />
			</Border>

			<!--  Service Info and Code  -->
			<StackPanel
				Grid.Column="1"
				Margin="6,0,0,0"
				VerticalAlignment="Center">
				<!--  Service Name  -->
				<TextBlock Style="{StaticResource ServiceNameTextStyle}" Text="{x:Bind AccountData.ServiceName, Mode=OneWay}" />

				<!--  Username  -->
				<TextBlock
					Margin="0,2,0,8"
					Style="{StaticResource UsernameTextStyle}"
					Text="{x:Bind AccountData.Username, Mode=OneWay}" />

				<!--  TOTP Code  -->
				<TextBlock
					Margin="0,0,0,4"
					FontSize="24"
					Style="{StaticResource CodeTextStyle}"
					Text="{x:Bind CurrentCode, Mode=OneWay}" />

				<!--  Progress Bar  -->
				<controls:TotpProgressBar
					Width="500"
					HorizontalAlignment="Left"
					Progress="{x:Bind Progress, Mode=OneWay}"
					SecondsRemaining="{x:Bind SecondsRemaining, Mode=OneWay}" />
			</StackPanel>

			<!--  Backup Codes Indicator  -->
			<StackPanel
				Grid.Column="2"
				Margin="12,0"
				VerticalAlignment="Center"
				Orientation="Horizontal">
				<FluidIcon
					Favorite="Refresh"
					FontSize="16"
					Foreground="{StaticResource SecondaryTextBrush}" />
				<TextBlock
					Margin="4,0,0,0"
					VerticalAlignment="Center"
					FontSize="12"
					Foreground="{StaticResource SecondaryTextBrush}"
					Text="{x:Bind AccountData.BackupCodes.Count, Mode=OneWay}" />
			</StackPanel>

			<!--  Action Buttons  -->
			<StackPanel
				Grid.Column="3"
				VerticalAlignment="Center"
				Orientation="Horizontal">
				<Button
					Click="CopyButton_Click"
					Style="{StaticResource IconButtonStyle}"
					ToolTipService.ToolTip="Copy code">
					<FluentIcon Favorite="Copy" FontSize="16" />
				</Button>
				<Button
					Click="MoreButton_Click"
					Style="{StaticResource IconButtonStyle}"
					ToolTipService.ToolTip="More options">
					<FluentIcon Favorite="More" FontSize="16" />
				</Button>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>